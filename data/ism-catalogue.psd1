        @{ Id = 'ISM-1580'; Section = 'Service continuity for online services'; Topic = 'Capacity and availability planning and monitoring for online services'; Rev = '1'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Where a high availability requirement exists for online services, the services are architected to automatically transition between availability zones.' }
