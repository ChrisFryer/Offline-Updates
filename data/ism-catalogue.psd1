        @{ Id = 'ISM-0988'; Section = 'Security monitoring'; Topic = 'Centralised event logging facility'; Rev = '7'; Updated = 'Sep-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'An accurate and consistent time source is used for event logging.' }
        @{ Id = 'ISM-0994'; Section = 'Cryptographic algorithms'; Topic = 'Asymmetric cryptographic algorithms'; Rev = '7'; Updated = 'Mar-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'ECDH is used in preference to DH.' }
        @{ Id = 'ISM-0998'; Section = 'Internet Protocol Security'; Topic = 'Integrity algorithms'; Rev = '5'; Updated = 'Mar-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'AUTH_HMAC_SHA2_256_128, AUTH_HMAC_SHA2_384_192, AUTH_HMAC_SHA2_512_256 or NONE (only with AES-GCM) is used for authenticating IPsec connections, preferably NONE.' }
        @{ Id = 'ISM-0999'; Section = 'Internet Protocol Security'; Topic = 'Diffie-Hellman groups'; Rev = '6'; Updated = 'Mar-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'DH or ECDH is used for key establishment of IPsec connections, preferably 384-bit random ECP group, 3072-bit MODP Group or 4096-bit MODP Group.' }
