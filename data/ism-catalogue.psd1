        @{ Id = 'ISM-1567'; Section = 'Cyber supply chain risk management'; Topic = 'Cyber supply chain risk management activities'; Rev = '2'; Updated = 'Sep-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Suppliers identified as high risk by a cyber supply chain risk assessment are not used.' }
        @{ Id = 'ISM-1568'; Section = 'Cyber supply chain risk management'; Topic = 'Cyber supply chain risk management activities'; Rev = '7'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Operating systems, applications, IT equipment, OT equipment and services are procured from suppliers that have demonstrated a commitment to the security of their products and services.' }
        @{ Id = 'ISM-1569'; Section = 'Cyber supply chain risk management'; Topic = 'Cyber supply chain risk management activities'; Rev = '3'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'A shared responsibility model is created, documented and shared between suppliers and their customers to articulate the security responsibilities of each party.' }
        @{ Id = 'ISM-1570'; Section = 'Managed services and cloud services'; Topic = 'Assessment of outsourced cloud service providers'; Rev = '2'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $false; Text = 'Outsourced cloud service providers and their non-classified, OFFICIAL: Sensitive, PROTECTED and SECRET cloud services undergo an IRAP assessment, using the latest release of the ISM available prior to the beginning of the IRAP assessment (or a subsequent release), at least every 24 months.' }
        @{ Id = 'ISM-1571'; Section = 'Managed services and cloud services'; Topic = 'Contractual security requirements with service providers'; Rev = '3'; Updated = 'Dec-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The right to verify compliance with security requirements is documented in contractual arrangements with service providers.' }
