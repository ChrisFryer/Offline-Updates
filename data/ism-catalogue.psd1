        @{ Id = 'ISM-0871'; Section = 'Mobile device usage'; Topic = 'Maintaining control of mobile devices'; Rev = '3'; Updated = 'Apr-19'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Mobile devices are kept under continual direct supervision when being actively used.' }
        @{ Id = 'ISM-0874'; Section = 'Enterprise mobility'; Topic = 'Mobile devices and desktop computers accessing the internet'; Rev = '7'; Updated = 'Mar-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Mobile devices and desktop computers access the internet via an organisation''s internet gateway rather than via a direct connection to the internet.' }
        @{ Id = 'ISM-0888'; Section = 'Development and maintenance of cyber security documentation'; Topic = 'Maintenance of cyber security documentation'; Rev = '7'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Cyber security documentation is reviewed at least annually and includes a ''current as at [date]'' or equivalent statement.' }
        @{ Id = 'ISM-0912'; Section = 'System-specific cyber security documentation'; Topic = 'Change and configuration management plan'; Rev = '6'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Systems have a change and configuration management plan that includes: * the establishment and maintenance of authorised baseline configurations for systems * what constitutes routine and urgent changes to the configuration of systems * how changes to the configuration of systems will be requested, tracked and documented * who needs to be consulted prior to routine and urgent changes to the configuration of systems * who needs to approve routine and urgent changes to the configuration of systems * who needs to be notified of routine and urgent changes to the configuration of systems * what additional change management and configuration management processes and procedures need to be followed before, during and after routine and urgent changes to the configuration of systems.' }
        @{ Id = 'ISM-0917'; Section = 'Responding to cyber security incidents'; Topic = 'Handling and containing malicious code infections'; Rev = '8'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When malicious code is detected, the following steps are taken to handle the infection: * the infected systems are isolated * all previously connected media used in the period leading up to the infection are scanned for signs of infection and isolated if necessary * antivirus applications are used to remove the infection from infected systems and media * if the infection cannot be reliably removed, systems are restored from a known good backup or rebuilt.' }
        @{ Id = 'ISM-0926'; Section = 'Cabling infrastructure'; Topic = 'Cable colours'; Rev = '11'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $false; TS = $false; Text = 'Non-classified, OFFICIAL: Sensitive and PROTECTED cables are coloured neither salmon pink nor red.' }
        @{ Id = 'ISM-0931'; Section = 'Telephone systems'; Topic = 'Off-hook audio protection'; Rev = '7'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'In SECRET and TOP SECRET areas, push-to-talk handsets or push-to-talk headsets are used to meet any off-hook audio protection requirements.' }
        @{ Id = 'ISM-0938'; Section = 'User application hardening'; Topic = 'User application selection'; Rev = '7'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Vendors that have demonstrated a commitment to Secure by Design and Secure by Default principles and practices, including secure programming practices and either memory-safe programming languages or less preferably memory-safe programming practices, are used for user applications.' }
        @{ Id = 'ISM-0947'; Section = 'Media usage'; Topic = 'Using media for data transfers'; Rev = '6'; Updated = 'Apr-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When transferring data manually between two systems belonging to different security domains, rewritable media is sanitised after each data transfer.' }
