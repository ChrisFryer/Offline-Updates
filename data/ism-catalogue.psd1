        @{ Id = 'ISM-1584'; Section = 'Operating system hardening'; Topic = 'Hardening operating system configurations'; Rev = '1'; Updated = 'Sep-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Unprivileged users are prevented from bypassing, disabling or modifying security functionality of operating systems.' }
