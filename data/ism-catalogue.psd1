        @{ Id = 'ISM-0731'; Section = 'Chief information security officer'; Topic = 'Working with suppliers'; Rev = '2'; Updated = 'Oct-20'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The CISO oversees cyber supply chain risk management activities for their organisation.' }
        @{ Id = 'ISM-0732'; Section = 'Chief information security officer'; Topic = 'Receiving and managing a dedicated cyber security budget'; Rev = '2'; Updated = 'Oct-20'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The CISO receives and manages a dedicated cyber security budget for their organisation.' }
        @{ Id = 'ISM-0733'; Section = 'Chief information security officer'; Topic = 'Overseeing cyber security incident response activities'; Rev = '2'; Updated = 'Oct-20'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The CISO is fully aware of all cyber security incidents within their organisation.' }
