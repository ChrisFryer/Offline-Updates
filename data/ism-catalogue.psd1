        @{ Id = 'ISM-1590'; Section = 'Credential management'; Topic = 'Changing credentials'; Rev = '5'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Credentials for user accounts are changed if: * they are compromised or suspected of being compromised * they are discovered stored on systems in the clear * they are discovered being transferred across networks in the clear * membership of a shared user account changes.' }
