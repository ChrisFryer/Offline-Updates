        @{ Id = 'ISM-1446'; Section = 'Cryptographic algorithms'; Topic = 'Using Elliptic Curve Cryptography'; Rev = '3'; Updated = 'Mar-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When using elliptic curve cryptography, a suitable curve from NIST SP 800-186 is used.' }
