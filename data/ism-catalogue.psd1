        @{ Id = 'ISM-0735'; Section = 'Chief information security officer'; Topic = 'Overseeing cyber security awareness training'; Rev = '3'; Updated = 'Dec-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The CISO oversees the development, implementation and maintenance of their organisation''s cyber security awareness training program.' }
        @{ Id = 'ISM-0810'; Section = 'Facilities and systems'; Topic = 'Physical access to systems'; Rev = '7'; Updated = 'Dec-24'; ML = 0; NC = $false; OS = $true; P = $true; S = $true; TS = $true; Text = 'Classified systems are secured in facilities that meet the requirements for a security zone suitable for their classification.' }
        @{ Id = 'ISM-0813'; Section = 'Facilities and systems'; Topic = 'Physical access to servers, network devices and cryptographic equipment'; Rev = '5'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Server rooms, communications rooms and security containers are not left in unsecured states.' }
