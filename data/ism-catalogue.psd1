        @{ Id = 'ISM-1553'; Section = 'Transport Layer Security'; Topic = 'Configuring Transport Layer Security'; Rev = '1'; Updated = 'Mar-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'TLS compression is disabled for TLS connections.' }
        @{ Id = 'ISM-1554'; Section = 'Mobile device usage'; Topic = 'Before travelling overseas with mobile devices'; Rev = '2'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'If travelling overseas with mobile devices to high or extreme risk countries, personnel are: * issued with newly provisioned user accounts, mobile devices and removable media from a pool of dedicated travel devices which are used solely for work-related activities * advised on how to apply and inspect tamper seals to key areas of mobile devices * advised to avoid taking any personal mobile devices, especially if rooted or jailbroken.' }
        @{ Id = 'ISM-1555'; Section = 'Mobile device usage'; Topic = 'Before travelling overseas with mobile devices'; Rev = '3'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Before travelling overseas with mobile devices, personnel take the following actions: * record all details of the mobile devices being taken, such as product types, serial numbers and International Mobile Equipment Identity numbers * update all operating systems and applications * remove all non-essential data, applications and user accounts * backup all remaining data, applications and settings.' }
        @{ Id = 'ISM-1556'; Section = 'Mobile device usage'; Topic = 'After travelling overseas with mobile devices'; Rev = '3'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'If returning from travelling overseas with mobile devices to high or extreme risk countries, personnel take the following additional actions: * reset credentials used with mobile devices, including those used for remote access to their organisation''s systems * monitor user accounts for any indicators of compromise, such as failed logon attempts.' }
        @{ Id = 'ISM-1557'; Section = 'Credential management'; Topic = 'Password strength'; Rev = '3'; Updated = 'Dec-25'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $false; Text = 'Passwords used for single-factor authentication on SECRET systems are a minimum of 17 characters.' }
        @{ Id = 'ISM-1558'; Section = 'Credential management'; Topic = 'Password strength'; Rev = '3'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Passwords using a sequence of words for single-factor authentication are not constructed using: * a list of categorised words * a real sentence in a natural language * song lyrics, movie or television show quotes, literature, or any other publicly available material * less than 4 random words for non-classified, OFFICIAL: Sensitive and PROTECTED systems; 5 random words for SECRET systems; or 6 random words for TOP SECRET systems.' }
        @{ Id = 'ISM-1559'; Section = 'Credential management'; Topic = 'Password strength'; Rev = '4'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $false; TS = $false; Text = 'Passwords used for multi-factor authentication on non-classified, OFFICIAL: Sensitive and PROTECTED systems are a minimum of 6 characters.' }
        @{ Id = 'ISM-1560'; Section = 'Credential management'; Topic = 'Password strength'; Rev = '3'; Updated = 'Dec-25'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $false; Text = 'Passwords used for multi-factor authentication on SECRET systems are a minimum of 8 characters.' }
