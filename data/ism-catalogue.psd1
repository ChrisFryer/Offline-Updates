        @{ Id = 'ISM-1438'; Section = 'Service continuity for online services'; Topic = 'Using content delivery networks'; Rev = '2'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Where a high availability requirement exists for website hosting, CDNs that cache websites are used.' }
