        @{ Id = 'ISM-0717'; Section = 'Chief information security officer'; Topic = 'Overseeing cyber security personnel'; Rev = '2'; Updated = 'Oct-20'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The CISO oversees the management of cyber security personnel within their organisation.' }
