        @{ Id = 'ISM-1592'; Section = 'Operating system hardening'; Topic = 'Application management'; Rev = '3'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Unprivileged human users do not have the ability to install unapproved applications.' }
