        @{ Id = 'ISM-1983'; Section = 'Security monitoring'; Topic = 'Centralised event logging facility'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs sent to a centralised event logging facility are sent as soon as possible after they occur.' }
        @{ Id = 'ISM-1984'; Section = 'Security monitoring'; Topic = 'Centralised event logging facility'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs sent to a centralised event logging facility are encrypted in transit using Australian Signals Directorate (ASD)-approved cryptography.' }
        @{ Id = 'ISM-1985'; Section = 'Security monitoring'; Topic = 'Centralised event logging facility'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs are protected from unauthorised access.' }
        @{ Id = 'ISM-1986'; Section = 'Security monitoring'; Topic = 'Event log monitoring'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs from critical servers are analysed in a timely manner to detect cyber security events.' }
        @{ Id = 'ISM-1987'; Section = 'Security monitoring'; Topic = 'Event log monitoring'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs from security products are analysed in a timely manner to detect cyber security events.' }
        @{ Id = 'ISM-1988'; Section = 'Security monitoring'; Topic = 'Event log retention'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs are retained in a searchable manner for at least 12 months.' }
        @{ Id = 'ISM-1989'; Section = 'Security monitoring'; Topic = 'Event log retention'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs are retained as per minimum retention requirements for various classes of records as set out by the National Archives of Australia''s Administrative Functions Disposal Authority Express (AFDA Express) Version 2 publication.' }
        @{ Id = 'ISM-1990'; Section = 'Cryptographic algorithms'; Topic = 'Using post-quantum cryptographic algorithms'; Rev = '1'; Updated = 'Mar-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When using ML-DSA and ML-KEM, as per FIPS 204 and FIPS 203 respectively, adherence to pre-requisite FIPS 140-3 validation is preferred.' }
        @{ Id = 'ISM-1991'; Section = 'Cryptographic algorithms'; Topic = 'Using the Module-Lattice-Based Digital Signature Algorithm'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When using ML-DSA for digital signatures, ML-DSA-65 or ML-DSA-87 is used, preferably ML-DSA-87.' }
        @{ Id = 'ISM-1992'; Section = 'Cryptographic algorithms'; Topic = 'Using the Module-Lattice-Based Digital Signature Algorithm'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When using ML-DSA for digital signatures, the hedged variant is used whenever possible.' }
        @{ Id = 'ISM-1993'; Section = 'Cryptographic algorithms'; Topic = 'Using the Module-Lattice-Based Digital Signature Algorithm'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Pre-hashed variants of ML-DSA-65 and ML-DSA-87 are only used when the performance of default variants is unacceptable.' }
        @{ Id = 'ISM-1994'; Section = 'Cryptographic algorithms'; Topic = 'Using the Module-Lattice-Based Digital Signature Algorithm'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When the pre-hashed variants of ML-DSA-65 and ML-DSA-87 are used, at least SHA-384 and SHA-512 respectively are used for pre-hashing.' }
        @{ Id = 'ISM-1995'; Section = 'Cryptographic algorithms'; Topic = 'Using the Module-Lattice-Based Key Encapsulation Mechanism'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When using ML-KEM for encapsulating encryption session keys (and similar keys), ML-KEM-768 or ML-KEM-1024 is used, preferably ML-KEM-1024.' }
        @{ Id = 'ISM-1996'; Section = 'Cryptographic algorithms'; Topic = 'Post-quantum traditional hybrid schemes'; Rev = '0'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When a post-quantum traditional hybrid scheme is used, either the post-quantum cryptographic algorithm, the traditional cryptographic algorithm or both are AACAs.' }
        @{ Id = 'ISM-1997'; Section = 'Board of directors and executive committee'; Topic = 'Embedding cyber security'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee defines clear roles and responsibilities for cyber security both within the board of directors or executive committee and broadly within their organisation.' }
        @{ Id = 'ISM-1998'; Section = 'Board of directors and executive committee'; Topic = 'Embedding cyber security'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee ensures that cyber security is integrated throughout all business functions within their organisation.' }
        @{ Id = 'ISM-1999'; Section = 'Board of directors and executive committee'; Topic = 'Embedding cyber security'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee ensures the cyber security strategy for their organisation is aligned with the overarching strategic direction and business strategy for their organisation.' }
        @{ Id = 'ISM-2000'; Section = 'Board of directors and executive committee'; Topic = 'Embedding cyber security'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee seeks regular briefings or reporting on the cyber security posture of their organisation, as well as the threat environment in which they operate, from internal and external subject matter experts.' }
        @{ Id = 'ISM-2001'; Section = 'Board of directors and executive committee'; Topic = 'Championing a positive cyber security culture'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee champions a positive cyber security culture within their organisation, including through leading by example.' }
        @{ Id = 'ISM-2002'; Section = 'Board of directors and executive committee'; Topic = 'Building cyber security expertise'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee maintains a sufficient level of cyber security literacy to fulfil both their fiduciary duties and any legislative or regulatory obligations.' }
        @{ Id = 'ISM-2003'; Section = 'Board of directors and executive committee'; Topic = 'Building cyber security expertise'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee maintains awareness of key cyber security recruitment activities, retention rates for cyber security personnel, and cyber security skills and experience gaps within their organisation.' }
        @{ Id = 'ISM-2004'; Section = 'Board of directors and executive committee'; Topic = 'Building cyber security expertise'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee supports the development of cyber security skills and experience for all personnel via internal and external cyber security awareness raising and training opportunities.' }
        @{ Id = 'ISM-2005'; Section = 'Board of directors and executive committee'; Topic = 'Identifying critical business assets'; Rev = '2'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee understands the business criticality of their organisation''s systems, including at least a basic understanding of what systems exist, their value, where they reside, who has access, who might seek access, how they are protected, and how that protection is verified.' }
        @{ Id = 'ISM-2006'; Section = 'Board of directors and executive committee'; Topic = 'Planning for major cyber security incidents'; Rev = '2'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The board of directors or executive committee plans for major cyber security incidents, including by participating in exercises, and understands their duties in relation to such cyber security incidents.' }
        @{ Id = 'ISM-2007'; Section = 'Facilities and systems'; Topic = 'Bringing medical devices into facilities'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'An authorised medical device register for SECRET and TOP SECRET areas is developed, implemented, maintained and regularly verified.' }
        @{ Id = 'ISM-2008'; Section = 'Facilities and systems'; Topic = 'Bringing medical devices into facilities'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Medical devices authorised to be brought into SECRET and TOP SECRET areas meet, at a minimum, the following criteria: * are listed on the Australian Register of Therapeutic Goods * have been prescribed by a legally qualified medical practitioner * have been commercially purchased within Australia * do not have inbuilt cellular connectivity * can operate independently of mobile devices * where possible, have Wi-Fi, Bluetooth and other forms of wireless connectivity disabled when operating within SECRET and TOP SECRET areas.' }
        @{ Id = 'ISM-2009'; Section = 'Facilities and systems'; Topic = 'Bringing medical devices into facilities'; Rev = '0'; Updated = 'Mar-25'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Unauthorised medical devices are not brought into SECRET and TOP SECRET areas.' }
        @{ Id = 'ISM-2010'; Section = 'Server application hardening'; Topic = 'Microsoft Active Directory Domain Services account hardening'; Rev = '0'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Service accounts configured with an SPN use the Advanced Encryption Standard for encryption.' }
        @{ Id = 'ISM-2011'; Section = 'Identity and access management'; Topic = 'Multi-factor authentication'; Rev = '1'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When phishing-resistant multi-factor authentication is used by human users, other non-phishing-resistant multi-factor authentication options are disabled for their user accounts.' }
        @{ Id = 'ISM-2012'; Section = 'Identity and access management'; Topic = 'Screen locking'; Rev = '1'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Systems are configured with a screen lock that: * activates after a maximum of 15 minutes of human user inactivity, or when manually activated * conceals all content on the screen * ensures that the screen does not enter a power saving state before the screen lock is activated * requires re-authentication by human users using all authentication factors to unlock the system * denies human users the ability to disable the screen locking mechanism.' }
        @{ Id = 'ISM-2013'; Section = 'Software development fundamentals'; Topic = 'Network application programming interfaces'; Rev = '0'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Authentication and authorisation of clients is performed when clients call network APIs that facilitate modification of data but are not accessible over the internet.' }
        @{ Id = 'ISM-2014'; Section = 'Software development fundamentals'; Topic = 'Network application programming interfaces'; Rev = '0'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Authentication and authorisation of clients is performed when clients call network APIs that facilitate access to data not authorised for release into the public domain but are not accessible over the internet.' }
        @{ Id = 'ISM-2015'; Section = 'Software development fundamentals'; Topic = 'Network application programming interfaces'; Rev = '0'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Network API calls that facilitate modification of data, or access to data not authorised for release into the public domain, but are not accessible over the internet, are centrally logged.' }
        @{ Id = 'ISM-2016'; Section = 'Software development fundamentals'; Topic = 'Software input handling'; Rev = '1'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Validation and sanitisation are performed on all input received over a local network by software.' }
        @{ Id = 'ISM-2017'; Section = 'Network design and configuration'; Topic = 'Encrypted Domain Name System Services'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'DNS traffic is encrypted by clients and servers using ASD-approved cryptography.' }
        @{ Id = 'ISM-2018'; Section = 'Gateways'; Topic = 'Border Gateway Protocol routing security'; Rev = '0'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Routes for RPKI-registered IP addresses that are advertised from invalid Autonomous Systems, or that are longer than allowed, are rejected or deprioritised by routers that exchange routes via BGP.' }
        @{ Id = 'ISM-2019'; Section = 'Gateways'; Topic = 'Assessment of gateways'; Rev = '1'; Updated = 'Sep-26'; ML = 0; NC = $false; OS = $false; P = $false; S = $false; TS = $true; Text = 'TOP SECRET gateways undergo a security control assessment by ASD assessors (or their delegates), using the latest release of the ISM available prior to the beginning of the assessment (or a subsequent release), at least every 24 months.' }
        @{ Id = 'ISM-2020'; Section = 'Chief information security officer'; Topic = 'Overseeing cyber security personnel'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The CISO ensures sufficient cyber security personnel, with the right skills and experience, are acquired to support cyber security activities within their organisation.' }
        @{ Id = 'ISM-2021'; Section = 'System owners'; Topic = 'Protecting systems and their resources'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'System owners implement and maintain data minimisation practices for each of their systems.' }
        @{ Id = 'ISM-2022'; Section = 'Cyber security awareness training'; Topic = 'Providing cyber security awareness training'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'A cyber security awareness training register is developed, implemented and maintained.' }
        @{ Id = 'ISM-2023'; Section = 'Software development fundamentals'; Topic = 'Authoritative source for software'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'An authoritative source for software is established and maintained.' }
        @{ Id = 'ISM-2024'; Section = 'Software development fundamentals'; Topic = 'Authoritative source for software'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The authoritative source for software is used for all software development activities.' }
        @{ Id = 'ISM-2025'; Section = 'Software development fundamentals'; Topic = 'Issue tracking'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'An issue tracking solution is used to link software development tasks to security issues and decisions, change or feature requests, programming issues, or bug fixes.' }
        @{ Id = 'ISM-2026'; Section = 'Software development fundamentals'; Topic = 'Software artefacts'; Rev = '1'; Updated = 'Mar-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'All software artefacts are scanned for malicious content before being imported into the authoritative source for software.' }
        @{ Id = 'ISM-2027'; Section = 'Software development fundamentals'; Topic = 'Software artefacts'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'All software artefacts are verified by a digital signature, or a secure hash provided over a secure channel, before being imported into the authoritative source for software.' }
        @{ Id = 'ISM-2028'; Section = 'Software development fundamentals'; Topic = 'Software artefacts'; Rev = '1'; Updated = 'Mar-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'All software artefacts are tested to detect known weaknesses using static application security testing (SAST), dynamic application security testing (DAST) or software composition analysis (SCA), depending on the software artefact type, before being imported into the authoritative source for software.' }
        @{ Id = 'ISM-2029'; Section = 'Software development fundamentals'; Topic = 'Software artefacts'; Rev = '1'; Updated = 'Sep-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The authoritative source for software restricts the use and import of third-party libraries and software components to trustworthy sources.' }
        @{ Id = 'ISM-2030'; Section = 'Software development fundamentals'; Topic = 'Software artefacts'; Rev = '1'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Scanning is used during commits to identify plain text or encoded credentials, keys and secrets, which are then blocked from being stored in the authoritative source for software.' }
        @{ Id = 'ISM-2031'; Section = 'Software development fundamentals'; Topic = 'Build solution'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Compilers, interpreters and build tools (including pipelines) that provide security features to improve executable file security are implemented and such security features are used.' }
        @{ Id = 'ISM-2032'; Section = 'Software development fundamentals'; Topic = 'Build solution'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The build solution ensures that all automated testing is completed without warnings, alerts or errors before building software artefacts.' }
        @{ Id = 'ISM-2033'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'All software security requirements are documented, stored securely and maintained throughout the software development life cycle.' }
        @{ Id = 'ISM-2034'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Security design decisions are documented and reviewed throughout the software development cycle.' }
        @{ Id = 'ISM-2035'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Security roles, responsibilities and knowledge required to support the software development life cycle are identified and documented.' }
        @{ Id = 'ISM-2036'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Security responsibilities for software developers are identified and documented.' }
        @{ Id = 'ISM-2037'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '2'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Software developers that lack sufficient cyber security knowledge and skills required for their projects or tasks undertake suitable training or upskilling on secure software development and programming practices.' }
        @{ Id = 'ISM-2038'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '2'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'A software developer cyber security knowledge and skills register is developed, implemented and maintained.' }
        @{ Id = 'ISM-2039'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The software threat model is reviewed throughout the software development life cycle to ensure it reflects the as-built software and any changes to the threat environment.' }
        @{ Id = 'ISM-2040'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Secure programming practices for the chosen programming language are used for software development.' }
        @{ Id = 'ISM-2041'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Memory-safe programming languages, or less preferably memory-safe programming practices, are used for software development.' }
        @{ Id = 'ISM-2042'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Secure by Default principles and practices are followed throughout the software development life cycle, including by ensuring that all built-in security measures are included and enabled in the base product at no extra cost to consumers.' }
        @{ Id = 'ISM-2043'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Software is architected and structured to support readability and maintainability.' }
        @{ Id = 'ISM-2044'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Software has no default credentials; however, if credentials are required, they are created on first install by the installing organisation.' }
        @{ Id = 'ISM-2045'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Application backwards compatibility does not compromise any security measures or features.' }
        @{ Id = 'ISM-2046'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Where software allows user impersonation, sensitive data is not logged and appropriate permissions are set.' }
        @{ Id = 'ISM-2047'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '1'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Where software allows an authentication factor to be reset for a human user, the human user is notified of the reset through a secondary channel.' }
        @{ Id = 'ISM-2048'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Where software supports multiple user roles, non-administrative users are prevented from altering their profile permissions or privileges.' }
        @{ Id = 'ISM-2049'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When user permissions or credentials are changed, software forces all impacted users to re-authenticate.' }
        @{ Id = 'ISM-2050'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When digital signatures are processed by software, they are validated against a certificate trust chain and checked for revocation using a Certificate Revocation List or with the Online Certificate Status Protocol.' }
        @{ Id = 'ISM-2051'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '1'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Software generates sufficient event logs to support the detection of cyber security events.' }
        @{ Id = 'ISM-2052'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Event logs produced by software ensure that any sensitive data is protected.' }
        @{ Id = 'ISM-2053'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'End of life procedures for software, including procedures for software removal and the archival or destruction of user accounts and data, are produced and made available to consumers.' }
        @{ Id = 'ISM-2054'; Section = 'Software development fundamentals'; Topic = 'Software bill of materials'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'If a software bill of materials is available for imported third-party software components, it is used during software development to ensure such software components have no known vulnerabilities.' }
        @{ Id = 'ISM-2055'; Section = 'Software development fundamentals'; Topic = 'Software build provenance'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'If a software build provenance is available for imported third-party software components, it is used during software development to ensure such software components are built to an appropriate standard.' }
        @{ Id = 'ISM-2056'; Section = 'Software development fundamentals'; Topic = 'Software build provenance'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'A software build provenance is produced and made available to consumers of software.' }
        @{ Id = 'ISM-2057'; Section = 'Software development fundamentals'; Topic = 'Software input handling'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'All input validation rules are documented, implemented in code, and tested using both positive and negative unit tests and integration tests.' }
        @{ Id = 'ISM-2058'; Section = 'Software development fundamentals'; Topic = 'Software input handling'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Data sources and serialised data inputs are validated before being deserialised.' }
        @{ Id = 'ISM-2059'; Section = 'Software development fundamentals'; Topic = 'Software input handling'; Rev = '0'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'File uploads or input are restricted to specific file types, with malicious content scanning occurring prior to file access, file execution or file storage.' }
        @{ Id = 'ISM-2060'; Section = 'Software development fundamentals'; Topic = 'Software security testing'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Code reviews are utilised to ensure software components meets Secure by Design principles and practices as well as secure programming practices.' }
        @{ Id = 'ISM-2061'; Section = 'Software development fundamentals'; Topic = 'Software security testing'; Rev = '1'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Peer reviews are conducted on all critical and security-related software components.' }
