        @{ Id = 'ISM-0820'; Section = 'Cyber security awareness training'; Topic = 'Posting work-related information on online services'; Rev = '6'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Personnel are advised not to post work-related information on unauthorised online services, and to report cases where such information is posted.' }
        @{ Id = 'ISM-0821'; Section = 'Cyber security awareness training'; Topic = 'Posting personal information on online services'; Rev = '4'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Personnel are advised of security risks associated with posting personal information on online services.' }
        @{ Id = 'ISM-0824'; Section = 'Cyber security awareness training'; Topic = 'Sending and receiving files via online services'; Rev = '2'; Updated = 'Sep-18'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Personnel are advised not to send or receive files via unauthorised online services.' }
        @{ Id = 'ISM-0829'; Section = 'Facilities and systems'; Topic = 'Bringing radio frequency and infrared devices into facilities'; Rev = '4'; Updated = 'Mar-19'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Security measures are used to detect and respond to unauthorised RF devices in SECRET and TOP SECRET areas.' }
        @{ Id = 'ISM-0831'; Section = 'Media usage'; Topic = 'Handling media'; Rev = '5'; Updated = 'Sep-18'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media is handled in a manner suitable for its sensitivity or classification.' }
        @{ Id = 'ISM-0835'; Section = 'Media sanitisation'; Topic = 'Treatment of volatile media following sanitisation'; Rev = '5'; Updated = 'Jun-26'; ML = 0; NC = $false; OS = $false; P = $false; S = $false; TS = $true; Text = 'Following sanitisation, TOP SECRET volatile media retains its classification if it stored static data for an extended period, or had data repeatedly stored on or written to the same memory location for an extended period.' }
        @{ Id = 'ISM-0836'; Section = 'Media sanitisation'; Topic = 'Non-volatile electrically erasable programmable read-only memory media sanitisation'; Rev = '3'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Non-volatile EEPROM media is sanitised by overwriting it at least once in its entirety with a random pattern followed by a read back for verification.' }
        @{ Id = 'ISM-0839'; Section = 'Media destruction'; Topic = 'Outsourcing media destruction'; Rev = '3'; Updated = 'Dec-21'; ML = 0; NC = $false; OS = $true; P = $true; S = $true; TS = $true; Text = 'The destruction of media storing accountable material is not outsourced.' }
        @{ Id = 'ISM-0840'; Section = 'Media destruction'; Topic = 'Outsourcing media destruction'; Rev = '4'; Updated = 'Jun-22'; ML = 0; NC = $false; OS = $true; P = $true; S = $true; TS = $false; Text = 'When outsourcing the destruction of media storing non-accountable material, a National Association for Information Destruction AAA certified destruction service with endorsements, as specified in ASIO''s Protective Security Circular-167, is used.' }
        @{ Id = 'ISM-0843'; Section = 'Operating system hardening'; Topic = 'Application control'; Rev = '9'; Updated = 'Sep-21'; ML = 1; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Application control is implemented on workstations.' }
        @{ Id = 'ISM-0846'; Section = 'Operating system hardening'; Topic = 'Application control'; Rev = '10'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Users cannot disable or bypass application control, and are not exempted from application control, except when using local administrator accounts or break glass accounts.' }
        @{ Id = 'ISM-0853'; Section = 'Identity and access management'; Topic = 'Session termination'; Rev = '5'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Interactive user sessions are terminated and workstations are restarted at least daily.' }
        @{ Id = 'ISM-0854'; Section = 'Identity and access management'; Topic = 'Control of Australian systems'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'AUSTEO and AGAO data can only be accessed from systems under the sole control of the Australian Government that are located within facilities authorised by the Australian Government.' }
        @{ Id = 'ISM-0861'; Section = 'Email gateways and servers'; Topic = 'DomainKeys Identified Mail'; Rev = '3'; Updated = 'Sep-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'DKIM signing is enabled on emails originating from an organisation''s domains (including subdomains).' }
        @{ Id = 'ISM-0863'; Section = 'Mobile device management'; Topic = 'Maintaining mobile device security'; Rev = '5'; Updated = 'Dec-23'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Mobile devices prevent personnel from installing non-approved applications once provisioned.' }
        @{ Id = 'ISM-0864'; Section = 'Mobile device management'; Topic = 'Maintaining mobile device security'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Mobile devices prevent personnel from disabling or modifying security functionality once provisioned.' }
        @{ Id = 'ISM-0866'; Section = 'Mobile device usage'; Topic = 'Using mobile devices in public spaces'; Rev = '6'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Sensitive or classified data is not viewed on mobile devices in public locations unless care is taken to reduce the chance of the screen of a mobile device being observed.' }
