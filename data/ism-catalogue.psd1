        @{ Id = 'ISM-1517'; Section = 'Media destruction'; Topic = 'Media destruction methods'; Rev = '0'; Updated = 'Sep-18'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Equipment that is capable of reducing microform to a fine powder, with resultant particles not showing more than five consecutive characters per particle upon microscopic inspection, is used to destroy microfiche and microfilm.' }
