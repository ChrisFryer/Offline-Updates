        @{ Id = 'ISM-0311'; Section = 'IT equipment sanitisation and destruction'; Topic = 'Sanitising IT equipment'; Rev = '7'; Updated = 'Jun-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'IT equipment containing media is sanitised by removing the media from the IT equipment or by sanitising the media in situ.' }
        @{ Id = 'ISM-0312'; Section = 'IT equipment sanitisation and destruction'; Topic = 'Sanitising highly sensitive IT equipment'; Rev = '7'; Updated = 'Jun-24'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'IT equipment, including associated media, that is located overseas and has processed, stored or communicated AUSTEO or AGAO data that cannot be sanitised in situ, is returned to Australia for destruction.' }
        @{ Id = 'ISM-0313'; Section = 'IT equipment sanitisation and destruction'; Topic = 'IT equipment sanitisation processes and procedures'; Rev = '7'; Updated = 'Jun-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'IT equipment sanitisation processes, and supporting IT equipment sanitisation procedures, are developed, implemented and maintained.' }
        @{ Id = 'ISM-0315'; Section = 'IT equipment sanitisation and destruction'; Topic = 'Destroying high assurance IT equipment'; Rev = '9'; Updated = 'Jun-24'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'High assurance IT equipment is destroyed prior to its disposal.' }
        @{ Id = 'ISM-0316'; Section = 'IT equipment disposal'; Topic = 'Disposal of IT equipment'; Rev = '4'; Updated = 'Jun-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Following sanitisation, destruction or declassification, a formal administrative decision is made to release IT equipment, or its waste, into the public domain.' }
        @{ Id = 'ISM-0317'; Section = 'IT equipment sanitisation and destruction'; Topic = 'Sanitising printers and multifunction devices'; Rev = '3'; Updated = 'Sep-18'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'At least three pages of random text with no blank areas are printed on each colour printer cartridge or MFD print drum.' }
        @{ Id = 'ISM-0318'; Section = 'IT equipment sanitisation and destruction'; Topic = 'Sanitising printers and multifunction devices'; Rev = '3'; Updated = 'Sep-18'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When unable to sanitise printer cartridges or MFD print drums, they are destroyed as per electrostatic memory devices.' }
        @{ Id = 'ISM-0321'; Section = 'IT equipment disposal'; Topic = 'Disposal of IT equipment'; Rev = '6'; Updated = 'Jun-24'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'When disposing of IT equipment that has been designed or modified to meet emanation security standards, ASD is contacted for requirements relating to its disposal.' }
        @{ Id = 'ISM-0323'; Section = 'Media usage'; Topic = 'Classifying media'; Rev = '8'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media is classified to the highest sensitivity or classification of data it stores, unless the media has been classified to a higher sensitivity or classification.' }
        @{ Id = 'ISM-0325'; Section = 'Media usage'; Topic = 'Reclassifying media'; Rev = '6'; Updated = 'Apr-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Any media connected to a system with a higher sensitivity or classification than the media is reclassified to the higher sensitivity or classification, unless the media is read-only or the system has a mechanism through which read-only access can be ensured.' }
        @{ Id = 'ISM-0330'; Section = 'Media usage'; Topic = 'Reclassifying media'; Rev = '7'; Updated = 'Mar-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Before reclassifying media to a lower sensitivity or classification, the media is sanitised or destroyed, and a formal administrative decision is made to reclassify it.' }
        @{ Id = 'ISM-0332'; Section = 'Media usage'; Topic = 'Labelling media'; Rev = '6'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media, except for internally mounted fixed media within information technology equipment, is labelled with protective markings reflecting its sensitivity or classification.' }
        @{ Id = 'ISM-0336'; Section = 'IT equipment usage'; Topic = 'IT equipment registers'; Rev = '10'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'A networked IT equipment register is developed, implemented, maintained and regularly verified.' }
        @{ Id = 'ISM-0337'; Section = 'Media usage'; Topic = 'Classifying media'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media is only used with systems that are authorised to process, store or communicate its sensitivity or classification.' }
        @{ Id = 'ISM-0341'; Section = 'Operating system hardening'; Topic = 'Hardening operating system configurations'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Automatic execution features for removable media are disabled.' }
        @{ Id = 'ISM-0343'; Section = 'Operating system hardening'; Topic = 'Device access control'; Rev = '7'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'If there is no business requirement for writing to removable media and devices, such functionality is disabled via the use of a device access control application or by disabling external communication interfaces.' }
        @{ Id = 'ISM-0345'; Section = 'Operating system hardening'; Topic = 'Device access control'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'External communication interfaces that allow DMA are disabled.' }
        @{ Id = 'ISM-0347'; Section = 'Media usage'; Topic = 'Using media for data transfers'; Rev = '5'; Updated = 'Apr-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When transferring data manually between two systems belonging to different security domains, write-once media is used unless the destination system has a mechanism through which read-only access can be ensured.' }
        @{ Id = 'ISM-0348'; Section = 'Media sanitisation'; Topic = 'Media sanitisation processes and procedures'; Rev = '5'; Updated = 'Dec-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media sanitisation processes, and supporting media sanitisation procedures, are developed, implemented and maintained.' }
        @{ Id = 'ISM-0350'; Section = 'Media destruction'; Topic = 'Media that cannot be sanitised'; Rev = '5'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The following media types are destroyed prior to their disposal: * microfiche and microfilm * optical discs * programmable read-only memory * read-only memory * other types of media that cannot be sanitised.' }
        @{ Id = 'ISM-0351'; Section = 'Media sanitisation'; Topic = 'Volatile media sanitisation'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Volatile media is sanitised by removing its power for at least 10 minutes.' }
        @{ Id = 'ISM-0352'; Section = 'Media sanitisation'; Topic = 'Volatile media sanitisation'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'SECRET and TOP SECRET volatile media is sanitised by overwriting it at least once in its entirety with a random pattern followed by a read back for verification.' }
        @{ Id = 'ISM-0354'; Section = 'Media sanitisation'; Topic = 'Non-volatile magnetic media sanitisation'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Non-volatile magnetic media is sanitised by overwriting it at least once (or three times if pre-2001 or under 15 GB) in its entirety with a random pattern followed by a read back for verification.' }
        @{ Id = 'ISM-0356'; Section = 'Media sanitisation'; Topic = 'Treatment of non-volatile magnetic media following sanitisation'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Following sanitisation, SECRET and TOP SECRET non-volatile magnetic media retains its classification.' }
        @{ Id = 'ISM-0357'; Section = 'Media sanitisation'; Topic = 'Non-volatile erasable programmable read-only memory media sanitisation'; Rev = '5'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Non-volatile EPROM media is sanitised by applying three times the manufacturer''s specified ultraviolet erasure time and then overwriting it at least once in its entirety with a random pattern followed by a read back for verification.' }
        @{ Id = 'ISM-0358'; Section = 'Media sanitisation'; Topic = 'Treatment of non-volatile erasable and electrically erasable programmable read-only memory media following sanitisation'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Following sanitisation, SECRET and TOP SECRET non-volatile EPROM and EEPROM media retains its classification.' }
        @{ Id = 'ISM-0359'; Section = 'Media sanitisation'; Topic = 'Non-volatile flash memory media sanitisation'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Non-volatile flash memory media is sanitised by overwriting it at least twice in its entirety with a random pattern followed by a read back for verification.' }
        @{ Id = 'ISM-0360'; Section = 'Media sanitisation'; Topic = 'Treatment of non-volatile flash memory media following sanitisation'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Following sanitisation, SECRET and TOP SECRET non-volatile flash memory media retains its classification.' }
        @{ Id = 'ISM-0361'; Section = 'Media destruction'; Topic = 'Degaussing magnetic media'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Magnetic media is destroyed using a degausser with a suitable magnetic field strength and magnetic orientation.' }
        @{ Id = 'ISM-0362'; Section = 'Media destruction'; Topic = 'Degaussing magnetic media'; Rev = '4'; Updated = 'Mar-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Product-specific directions provided by degausser manufacturers are followed.' }
        @{ Id = 'ISM-0363'; Section = 'Media destruction'; Topic = 'Media destruction processes and procedures'; Rev = '4'; Updated = 'Dec-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media destruction processes, and supporting media destruction procedures, are developed, implemented and maintained.' }
        @{ Id = 'ISM-0368'; Section = 'Media destruction'; Topic = 'Media destruction methods'; Rev = '8'; Updated = 'Mar-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media destroyed using a hammer mill, disintegrator, grinder/sander or by cutting results in media waste particles no larger than 9 mm.' }
        @{ Id = 'ISM-0370'; Section = 'Media destruction'; Topic = 'Supervision of destruction'; Rev = '6'; Updated = 'Sep-23'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The destruction of media is performed under the supervision of at least one cleared person.' }
        @{ Id = 'ISM-0371'; Section = 'Media destruction'; Topic = 'Supervision of destruction'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Personnel supervising the destruction of media supervise its handling to the point of destruction and ensure that the destruction is completed successfully.' }
        @{ Id = 'ISM-0372'; Section = 'Media destruction'; Topic = 'Supervision of accountable material destruction'; Rev = '6'; Updated = 'Sep-23'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The destruction of media storing accountable material is performed under the supervision of at least two cleared personnel.' }
        @{ Id = 'ISM-0373'; Section = 'Media destruction'; Topic = 'Supervision of accountable material destruction'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Personnel supervising the destruction of media storing accountable material supervise its handling to the point of destruction, ensure that the destruction is completed successfully and sign a destruction certificate afterwards.' }
        @{ Id = 'ISM-0374'; Section = 'Media disposal'; Topic = 'Media disposal processes and procedures'; Rev = '4'; Updated = 'Dec-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Media disposal processes, and supporting media disposal procedures, are developed, implemented and maintained.' }
        @{ Id = 'ISM-0375'; Section = 'Media disposal'; Topic = 'Disposal of media'; Rev = '6'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Following sanitisation, destruction or declassification, a formal administrative decision is made to release media, or its waste, into the public domain.' }
        @{ Id = 'ISM-0378'; Section = 'Media disposal'; Topic = 'Disposal of media'; Rev = '4'; Updated = 'Dec-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Labels and markings indicating the owner, sensitivity, classification or any other marking that can associate media with its prior use are removed prior to its disposal.' }
        @{ Id = 'ISM-0380'; Section = 'Operating system hardening'; Topic = 'Hardening operating system configurations'; Rev = '10'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Unneeded user accounts, components, services and functionality of operating systems are disabled or removed.' }
        @{ Id = 'ISM-0382'; Section = 'Operating system hardening'; Topic = 'Application management'; Rev = '9'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Unprivileged human users do not have the ability to uninstall or disable approved applications.' }
        @{ Id = 'ISM-0383'; Section = 'Operating system hardening'; Topic = 'Hardening operating system configurations'; Rev = '11'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Default user accounts or credentials for operating systems, including for any pre-configured user accounts, are changed, disabled or removed during initial setup.' }
        @{ Id = 'ISM-0385'; Section = 'Network design and configuration'; Topic = 'Functional separation between servers'; Rev = '7'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Servers maintain effective functional separation from each other.' }
        @{ Id = 'ISM-0393'; Section = 'Databases'; Topic = 'Protecting database contents'; Rev = '8'; Updated = 'Jun-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Databases and their contents are classified based on the sensitivity or classification of data that they contain.' }
        @{ Id = 'ISM-0400'; Section = 'Software development fundamentals'; Topic = 'Development, testing, staging and production environments'; Rev = '6'; Updated = 'Mar-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Development, testing, staging and production environments are segregated.' }
        @{ Id = 'ISM-0401'; Section = 'Software development fundamentals'; Topic = 'Secure software development'; Rev = '8'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Secure by Design principles and practices are followed throughout the software development life cycle.' }
        @{ Id = 'ISM-0402'; Section = 'Software development fundamentals'; Topic = 'Software security testing'; Rev = '10'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Software is comprehensively tested for vulnerabilities using SAST, DAST and SCA prior to its initial release, any subsequent release, and periodically to help identify any previously unidentified vulnerabilities.' }
        @{ Id = 'ISM-0405'; Section = 'Identity and access management'; Topic = 'Unprivileged access to systems'; Rev = '8'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Requests for unprivileged access to systems and their resources are validated when first requested.' }
        @{ Id = 'ISM-0407'; Section = 'Identity and access management'; Topic = 'Recording authorisation for personnel to access systems'; Rev = '7'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'A secure record is maintained for the life of systems and their resources that covers the following for each human user: * their unique identifier * their signed agreement to abide by system usage policies * who authorised their access * when their access was granted * the level of access they were granted * when their access, and their level of access, was last reviewed * when their level of access was changed, and to what extent (if applicable) * when their access was withdrawn (if applicable).' }
        @{ Id = 'ISM-0408'; Section = 'Identity and access management'; Topic = 'System access requirements'; Rev = '6'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Systems have a logon banner that reminds personnel of their security responsibilities when accessing the system and its resources.' }
        @{ Id = 'ISM-0409'; Section = 'Identity and access management'; Topic = 'Unprivileged access to systems by foreign nationals'; Rev = '9'; Updated = 'Sep-26'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Foreign nationals, including seconded foreign nationals, do not have access to systems that process, store or communicate AUSTEO or REL data unless effective security controls are in place to ensure such data is not accessible to them.' }
        @{ Id = 'ISM-0411'; Section = 'Identity and access management'; Topic = 'Unprivileged access to systems by foreign nationals'; Rev = '8'; Updated = 'Sep-26'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Foreign nationals, excluding seconded foreign nationals, do not have access to systems that process, store or communicate AGAO data unless effective security controls are in place to ensure such data is not accessible to them.' }
        @{ Id = 'ISM-0414'; Section = 'Identity and access management'; Topic = 'User identification'; Rev = '6'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Users granted access to systems and their resources are uniquely identifiable.' }
        @{ Id = 'ISM-0415'; Section = 'Identity and access management'; Topic = 'User identification'; Rev = '4'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'The use of shared user accounts is strictly controlled, and users of such accounts are uniquely identifiable.' }
        @{ Id = 'ISM-0417'; Section = 'Identity and access management'; Topic = 'Single-factor authentication'; Rev = '6'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When systems cannot support multi-factor authentication, single-factor authentication using passwords is implemented instead.' }
        @{ Id = 'ISM-0418'; Section = 'Credential management'; Topic = 'Protecting credentials'; Rev = '7'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Physical credentials are kept separate from systems they are used to authenticate to, except for when performing authentication activities.' }
        @{ Id = 'ISM-0420'; Section = 'Identity and access management'; Topic = 'User identification'; Rev = '12'; Updated = 'Jun-25'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Where systems process, store or communicate AUSTEO, AGAO or REL data, personnel who are foreign nationals are identified as such, including by their specific nationality.' }
        @{ Id = 'ISM-0421'; Section = 'Credential management'; Topic = 'Password strength'; Rev = '11'; Updated = 'Dec-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $false; TS = $false; Text = 'Passwords used for single-factor authentication on non-classified, OFFICIAL: Sensitive and PROTECTED systems are a minimum of 15 characters.' }
        @{ Id = 'ISM-0422'; Section = 'Credential management'; Topic = 'Password strength'; Rev = '9'; Updated = 'Dec-25'; ML = 0; NC = $false; OS = $false; P = $false; S = $false; TS = $true; Text = 'Passwords used for single-factor authentication on TOP SECRET systems are a minimum of 20 characters.' }
        @{ Id = 'ISM-0428'; Section = 'Identity and access management'; Topic = 'Session locking'; Rev = '11'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Services are configured with a session lock that: * activates after a maximum of 15 minutes of human user inactivity, a maximum of 12 hours of overall session time or when manually activated * blocks access to all session content * requires re-authentication by human users using all authentication factors to unlock the session * denies human users the ability to disable the session locking mechanism.' }
        @{ Id = 'ISM-0430'; Section = 'Identity and access management'; Topic = 'Suspension of access to systems'; Rev = '9'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Access to systems and their resources are removed or suspended the same day users no longer have a legitimate requirement for access.' }
        @{ Id = 'ISM-0432'; Section = 'Identity and access management'; Topic = 'System access requirements'; Rev = '8'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Access requirements for systems and their resources are documented in their system security plan.' }
        @{ Id = 'ISM-0434'; Section = 'Identity and access management'; Topic = 'System access requirements'; Rev = '8'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Personnel undergo appropriate employment screening and, where necessary, hold an appropriate security clearance before being granted access to systems and their resources.' }
        @{ Id = 'ISM-0435'; Section = 'Identity and access management'; Topic = 'System access requirements'; Rev = '4'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Personnel receive any necessary briefings before being granted access to systems and their resources.' }
        @{ Id = 'ISM-0441'; Section = 'Identity and access management'; Topic = 'Temporary access to systems'; Rev = '10'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When personnel are granted temporary access to systems and their resources, effective security controls are put in place to restrict their access to only data required for them to undertake their duties or functions.' }
        @{ Id = 'ISM-0443'; Section = 'Identity and access management'; Topic = 'Temporary access to systems'; Rev = '3'; Updated = 'Sep-18'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Temporary access is not granted to systems that process, store or communicate caveated or sensitive compartmented information.' }
        @{ Id = 'ISM-0445'; Section = 'Identity and access management'; Topic = 'Privileged access to systems'; Rev = '9'; Updated = 'Sep-26'; ML = 1; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Privileged human users are assigned a dedicated privileged user account to be used solely for duties requiring privileged access.' }
        @{ Id = 'ISM-0446'; Section = 'Identity and access management'; Topic = 'Privileged access to systems by foreign nationals'; Rev = '5'; Updated = 'Jun-21'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Foreign nationals, including seconded foreign nationals, do not have privileged access to systems that process, store or communicate AUSTEO or REL data.' }
        @{ Id = 'ISM-0447'; Section = 'Identity and access management'; Topic = 'Privileged access to systems by foreign nationals'; Rev = '4'; Updated = 'Jun-21'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Foreign nationals, excluding seconded foreign nationals, do not have privileged access to systems that process, store or communicate AGAO data.' }
        @{ Id = 'ISM-0455'; Section = 'Cryptographic fundamentals'; Topic = 'Data recovery'; Rev = '5'; Updated = 'Sep-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Where practical, cryptographic equipment, applications and libraries provide a means of data recovery to allow for circumstances where the encryption key is unavailable due to loss, damage or failure.' }
        @{ Id = 'ISM-0457'; Section = 'Cryptographic fundamentals'; Topic = 'Cryptographic implementation assurance'; Rev = '11'; Updated = 'Sep-25'; ML = 0; NC = $false; OS = $true; P = $true; S = $false; TS = $false; Text = 'Cryptographic equipment, applications or libraries that have completed a Common Criteria evaluation against an ASD-endorsed Protection Profile are used when encrypting media that contains OFFICIAL: Sensitive or PROTECTED data.' }
        @{ Id = 'ISM-0459'; Section = 'Media usage'; Topic = 'Encrypting media'; Rev = '5'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Full disk encryption, or partial encryption where access controls only allow writing to encrypted partitions or volumes, is implemented when encrypting media.' }
        @{ Id = 'ISM-0460'; Section = 'Cryptographic fundamentals'; Topic = 'Cryptographic implementation assurance'; Rev = '13'; Updated = 'Sep-23'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'HACE is used when encrypting media that contains SECRET or TOP SECRET data.' }
        @{ Id = 'ISM-0462'; Section = 'Cryptographic fundamentals'; Topic = 'Handling encrypted IT equipment and media'; Rev = '8'; Updated = 'Jun-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'When a user authenticates to the encryption functionality of IT equipment or media, it is treated in accordance with its original sensitivity or classification until the user deauthenticates from the encryption functionality.' }
        @{ Id = 'ISM-0465'; Section = 'Cryptographic fundamentals'; Topic = 'Cryptographic implementation assurance'; Rev = '11'; Updated = 'Sep-25'; ML = 0; NC = $false; OS = $true; P = $true; S = $false; TS = $false; Text = 'Cryptographic equipment, applications or libraries that have completed a Common Criteria evaluation against an ASD-endorsed Protection Profile are used to protect OFFICIAL: Sensitive or PROTECTED data when communicated over insufficiently secure networks, outside of appropriately secure areas or via public network infrastructure.' }
        @{ Id = 'ISM-0467'; Section = 'Cryptographic fundamentals'; Topic = 'Cryptographic implementation assurance'; Rev = '12'; Updated = 'Sep-23'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'HACE is used to protect SECRET and TOP SECRET data when communicated over insufficiently secure networks, outside of appropriately secure areas or via public network infrastructure.' }
        @{ Id = 'ISM-0469'; Section = 'Cryptographic protocols'; Topic = 'Using cryptographic protocols'; Rev = '7'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'An AACP or high assurance cryptographic protocol is used when encrypting data in transit.' }
        @{ Id = 'ISM-0471'; Section = 'Cryptographic algorithms'; Topic = 'Using cryptographic algorithms'; Rev = '9'; Updated = 'Sep-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Only AACAs or high assurance cryptographic algorithms are used by cryptographic equipment, applications and libraries.' }
        @{ Id = 'ISM-0472'; Section = 'Cryptographic algorithms'; Topic = 'Using Diffie-Hellman'; Rev = '7'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $false; TS = $false; Text = 'When using DH for agreeing on encryption session keys, a modulus of at least 2048 bits is used, preferably 3072 bits.' }
        @{ Id = 'ISM-0474'; Section = 'Cryptographic algorithms'; Topic = 'Using Elliptic Curve Diffie-Hellman'; Rev = '7'; Updated = 'Dec-24'; ML = 0; NC = $true; OS = $true; P = $true; S = $false; TS = $false; Text = 'When using ECDH for agreeing on encryption session keys, a base point order and key size of at least 224 bits is used, preferably the NIST P-384 curve.' }
