        @{ Id = 'ISM-1452'; Section = 'Cyber supply chain risk management'; Topic = 'Cyber supply chain risk management activities'; Rev = '7'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'A supply chain risk assessment is performed for suppliers of operating systems, applications, IT equipment, OT equipment and services to assess the impact to a system''s security risk profile.' }
