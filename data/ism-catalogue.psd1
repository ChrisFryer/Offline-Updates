        @{ Id = 'ISM-1454'; Section = 'Network design and configuration'; Topic = 'Remote Authentication Dial-In User Service authentication'; Rev = '2'; Updated = 'Sep-21'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'Communications between authenticators and a RADIUS server are encapsulated with an additional layer of encryption using RADIUS over Internet Protocol Security or RADIUS over Transport Layer Security.' }
