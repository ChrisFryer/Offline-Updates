        @{ Id = 'ISM-1535'; Section = 'Data transfers'; Topic = 'Data transfer processes and procedures'; Rev = '6'; Updated = 'Jun-24'; ML = 0; NC = $false; OS = $false; P = $false; S = $true; TS = $true; Text = 'Processes, and supporting procedures, are developed, implemented and maintained to prevent AUSTEO, AGAO and REL data in textual and non-textual formats from being exported to unsuitable foreign systems.' }
        @{ Id = 'ISM-1536'; Section = 'Software development fundamentals'; Topic = 'Software interaction with databases'; Rev = '4'; Updated = 'Sep-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'All queries to databases from software, and any resulting crash or error messages, are centrally logged.' }
