        @{ Id = 'ISM-1417'; Section = 'Operating system hardening'; Topic = 'Antivirus application'; Rev = '6'; Updated = 'Jun-26'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'An antivirus application is implemented on workstations and servers with: * signature-based detection functionality enabled and set to a high level * heuristic-based detection functionality enabled and set to a high level * reputation rating functionality enabled * ransomware protection functionality enabled * detection signatures configured to update at least daily * regular scanning configured for all fixed disks and removable media.' }
        @{ Id = 'ISM-1418'; Section = 'Operating system hardening'; Topic = 'Device access control'; Rev = '5'; Updated = 'Jun-25'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'If there is no business requirement for reading from removable media and devices, such functionality is disabled via the use of a device access control application or by disabling external communication interfaces.' }
