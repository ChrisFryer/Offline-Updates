        @{ Id = 'ISM-0958'; Section = 'Web content filters'; Topic = 'Allowing and blocking access to domain names'; Rev = '8'; Updated = 'Mar-22'; ML = 0; NC = $true; OS = $true; P = $true; S = $true; TS = $true; Text = 'An organisation-approved list of domain names, or list of website categories, is implemented for all Hypertext Transfer Protocol and Hypertext Transfer Protocol Secure traffic communicated through gateways.' }
