        @{ Id = 'ISM-1400'; Section = 'Enterprise mobility'; Topic = 'Privately owned mobile devices and desktop computers'; Rev = '11'; Updated = 'Jun-26'; ML = 0; NC = $false; OS = $true; P = $true; S = $false; TS = $false; Text = 'Personnel using privately owned mobile devices or desktop computers to access OFFICIAL: Sensitive or PROTECTED systems or data have enforced separation of classified data and personal data.' }
