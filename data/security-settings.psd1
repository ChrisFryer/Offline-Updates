        @{ Id = 'SEC-PS-07';  Group = 'PowerShell'; Title = 'WMI activity log enabled';                   Key = 'WMI.ActivityLogEnabled';  Op = 'eq'; Expected = 'True'; Ism = 'ISM-2129'; ML = 0; Severity = 'Low'; Fix = 'wevtutil sl Microsoft-Windows-WMI-Activity/Operational /e:true  and forward it' }

        # ---- Removable media, logging sizes, remote access ----
        @{ Id = 'SEC-MED-01'; Group = 'Removable media'; Title = 'Removable storage access denied';       Key = 'RemovableStorage.DenyAll'; Op = 'eq'; Expected = '1'; Ism = 'ISM-1418'; ML = 0; Severity = 'Low'; Fix = 'GPO: Admin Templates > System > Removable Storage Access > All Removable Storage classes: Deny all access = Enabled (if no business need)' }
        @{ Id = 'SEC-LOG-02'; Group = 'Logging'; Title = 'Security log size at least 192 MB';              Key = 'EventLog.Security.MaxMB'; Op = 'ge'; Expected = '192'; Ism = 'ISM-1988'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Admin Templates > Windows Components > Event Log Service > Security > Specify the maximum log file size = 196608 KB or more (ASD suggests larger where logs are not forwarded)' }
        @{ Id = 'SEC-LOG-03'; Group = 'Logging'; Title = 'System log size at least 32 MB';                 Key = 'EventLog.System.MaxMB';   Op = 'ge'; Expected = '32';  Ism = 'ISM-1988'; ML = 0; Severity = 'Low';    Fix = 'GPO: Event Log Service > System > Specify the maximum log file size = 32768 KB or more' }
        @{ Id = 'SEC-LOG-04'; Group = 'Logging'; Title = 'Application log size at least 32 MB';            Key = 'EventLog.Application.MaxMB'; Op = 'ge'; Expected = '32'; Ism = 'ISM-1988'; ML = 0; Severity = 'Low';  Fix = 'GPO: Event Log Service > Application > Specify the maximum log file size = 32768 KB or more' }
        @{ Id = 'SEC-NET-01'; Group = 'Remote access'; Title = 'RDP requires Network Level Authentication'; Key = 'RDP.NLA';               Op = 'eq'; Expected = '1';   Ism = 'ISM-1409'; ML = 0; Severity = 'High';   Fix = 'GPO: Remote Desktop Session Host > Security > Require user authentication for remote connections by using NLA = Enabled' }
        @{ Id = 'SEC-NET-02'; Group = 'Remote access'; Title = 'RDP security layer = TLS';                 Key = 'RDP.SecurityLayer';       Op = 'eq'; Expected = '2';   Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Remote Desktop Session Host > Security > Require use of specific security layer for remote (RDP) connections = SSL (TLS 1.0)' }
        @{ Id = 'SEC-NET-03'; Group = 'Remote access'; Title = 'WinRM service: Basic authentication off';  Key = 'WinRM.Basic';             Op = 'eq'; Expected = 'false'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Windows Remote Management (WinRM) > WinRM Service > Allow Basic authentication = Disabled' }
        @{ Id = 'SEC-NET-04'; Group = 'Remote access'; Title = 'WinRM service: unencrypted traffic off';   Key = 'WinRM.AllowUnencrypted';  Op = 'eq'; Expected = 'false'; Ism = 'ISM-1409'; ML = 0; Severity = 'High';   Fix = 'GPO: WinRM Service > Allow unencrypted traffic = Disabled' }
        @{ Id = 'SEC-NET-05'; Group = 'Remote access'; Title = 'WinRM client: TrustedHosts empty';         Key = 'WinRM.TrustedHosts';      Op = 'eq'; Expected = '';    Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; NotConfiguredOk = $true; Fix = 'Clear-Item WSMan:\localhost\Client\TrustedHosts ; use FQDNs and Kerberos instead' }
        @{ Id = 'SEC-NET-06'; Group = 'Remote access'; Title = 'TLS 1.0 server disabled';                  Key = 'TLS.TLS1.0.Server';       Op = 'eq'; Expected = 'Disabled'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.0\Server: Enabled = 0, DisabledByDefault = 1 (test applications first)' }
        @{ Id = 'SEC-NET-07'; Group = 'Remote access'; Title = 'TLS 1.1 server disabled';                  Key = 'TLS.TLS1.1.Server';       Op = 'eq'; Expected = 'Disabled'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'SCHANNEL\Protocols\TLS 1.1\Server: Enabled = 0, DisabledByDefault = 1' }
        # ---- Cryptography by classification (ISM-1759 DH modulus; the cipher-suite, curve and certificate checks are code checks) ----
        @{ Id = 'SEC-CRY-01'; Group = 'Cryptography'; Title = 'Diffie-Hellman server minimum key length 3072 bits (SECRET and above)'; Key = 'TLS.DH.ServerMinKeyBitLength'; Op = 'ge'; Expected = '3072'; Ism = 'ISM-1759'; ML = 0; Severity = 'Medium'; Fix = 'Registry (GPP): HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\KeyExchangeAlgorithms\Diffie-Hellman, ServerMinKeyBitLength (DWORD) = 3072; the default of 2048 bits is below the ISM''s 3072 for SECRET and TOP SECRET (ISM-1759)' }
        @{ Id = 'SEC-NET-08'; Group = 'Remote access'; Title = 'SSL 3.0 server disabled';                  Key = 'TLS.SSL3.0.Server';       Op = 'eq'; Expected = 'Disabled'; NotConfiguredOk = $true; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'SCHANNEL\Protocols\SSL 3.0\Server: Enabled = 0, DisabledByDefault = 1' }
        @{ Id = 'SEC-NET-09'; Group = 'Remote access'; Title = 'LLMNR disabled';                           Key = 'LLMNR.EnableMulticast';   Op = 'eq'; Expected = '0';   Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Admin Templates > Network > DNS Client > Turn off multicast name resolution = Enabled' }
        @{ Id = 'SEC-NET-10'; Group = 'Remote access'; Title = 'NetBIOS over TCP/IP disabled on every adapter'; Key = 'NetBIOS.Options'; Op = 'match'; Expected = '^(2;)*2$'; Ism = 'ISM-1409'; ML = 0; Severity = 'Low'; Fix = 'Adapter > IPv4 > Advanced > WINS > Disable NetBIOS over TCP/IP (or DHCP option 001 Microsoft Disable Netbios = 2)' }
