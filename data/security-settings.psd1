@{
    # =================================================================
    #  security-settings.psd1  -  the EXPECTED VALUE of every setting the
    #  Security console checks one-for-one: audit policy subcategories,
    #  local security policy, security options, user rights, hardening keys.
    #  Each entry becomes a check (see 40-Console-Security.ps1).  The keys
    #  are the ones the Settings and SecurityPolicy collectors produce:
    #     Audit:<subcategory>   from  auditpol /get /category:* /r
    #     Sec:<name>            from  secedit /export  [System Access]
    #     Right:<privilege>     from  secedit /export  [Privilege Rights]  (SIDs, *S-1-5-32-544 = Administrators)
    #     everything else       from  the Settings collector (registry, cmdlets)
    #  Op:  eq  ne  ge  le  between (Expected '1-5')  in (Expected 'a;b')
    #       contains  subset (every entry of the actual list is in Expected)  match (regex)  report (never fails)
    #  A value of NotConfigured gives a Warn ("OS default applies") unless NotConfiguredOk = $true; Unknown = not read.
    #  ExpectedAt = @{ S = ...; TS = ... } (optional) replaces Expected at that classification (NC / OS / P / S / TS,
    #  the Security profile), e.g. the password length the ISM asks for on SECRET and TOP SECRET systems.
    #  ML = the Essential Eight maturity level the check evidences = the lowest ML among the ISM controls it cites
    #  (0 = none of them is an Essential Eight control); the self-test holds the two together.
    #  Expected values follow ASD's Windows hardening guidance and the Microsoft security baseline;
    #  tune them with the Security console's tailoring, not by weakening this file silently.
    # =================================================================
    AsOf = '2026-10-16'
    Settings = @(
        # ---- Audit policy (ISM-0582 security events logged; ISM-1509/1650 privileged access and group management; ISM-1889 command line) ----
        @{ Id = 'SEC-AUD-01'; Group = 'Audit policy'; Title = 'Audit Credential Validation';            Key = 'Audit:Credential Validation';            Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-0582';          ML = 0; Severity = 'Medium'; Fix = 'auditpol /set /subcategory:"Credential Validation" /success:enable /failure:enable   (GPO: Advanced Audit Policy Configuration > Account Logon)' }
        @{ Id = 'SEC-AUD-02'; Group = 'Audit policy'; Title = 'Audit Logon';                            Key = 'Audit:Logon';                            Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1509';          ML = 2; Severity = 'High';   Fix = 'auditpol /set /subcategory:"Logon" /success:enable /failure:enable   (GPO: Advanced Audit Policy > Logon/Logoff)' }
        @{ Id = 'SEC-AUD-03'; Group = 'Audit policy'; Title = 'Audit Logoff';                           Key = 'Audit:Logoff';                           Op = 'contains'; Expected = 'Success';          Ism = 'ISM-0582';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Logoff" /success:enable' }
        @{ Id = 'SEC-AUD-04'; Group = 'Audit policy'; Title = 'Audit Account Lockout';                  Key = 'Audit:Account Lockout';                  Op = 'contains'; Expected = 'Failure';          Ism = 'ISM-1403';          ML = 0; Severity = 'Medium'; Fix = 'auditpol /set /subcategory:"Account Lockout" /failure:enable' }
        @{ Id = 'SEC-AUD-05'; Group = 'Audit policy'; Title = 'Audit Special Logon';                    Key = 'Audit:Special Logon';                    Op = 'contains'; Expected = 'Success';          Ism = 'ISM-1509';          ML = 2; Severity = 'Medium'; Fix = 'auditpol /set /subcategory:"Special Logon" /success:enable' }
        @{ Id = 'SEC-AUD-06'; Group = 'Audit policy'; Title = 'Audit Other Logon/Logoff Events';        Key = 'Audit:Other Logon/Logoff Events';        Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-0582';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Other Logon/Logoff Events" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-07'; Group = 'Audit policy'; Title = 'Audit User Account Management';          Key = 'Audit:User Account Management';          Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1650';          ML = 2; Severity = 'High';   Fix = 'auditpol /set /subcategory:"User Account Management" /success:enable /failure:enable   (GPO: Advanced Audit Policy > Account Management)' }
        @{ Id = 'SEC-AUD-08'; Group = 'Audit policy'; Title = 'Audit Security Group Management';        Key = 'Audit:Security Group Management';        Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1650';          ML = 2; Severity = 'High';   Fix = 'auditpol /set /subcategory:"Security Group Management" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-09'; Group = 'Audit policy'; Title = 'Audit Computer Account Management';      Key = 'Audit:Computer Account Management';      Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1650';          ML = 2; Severity = 'Medium'; Fix = 'auditpol /set /subcategory:"Computer Account Management" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-10'; Group = 'Audit policy'; Title = 'Audit Other Account Management Events';  Key = 'Audit:Other Account Management Events';  Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1650';          ML = 2; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Other Account Management Events" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-11'; Group = 'Audit policy'; Title = 'Audit Process Creation';                 Key = 'Audit:Process Creation';                 Op = 'contains'; Expected = 'Success';          Ism = 'ISM-1889';          ML = 2; Severity = 'High';   Fix = 'auditpol /set /subcategory:"Process Creation" /success:enable  plus "Include command line in process creation events" (SEC-PS-06)' }
        @{ Id = 'SEC-AUD-12'; Group = 'Audit policy'; Title = 'Audit Audit Policy Change';              Key = 'Audit:Audit Policy Change';              Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1815';          ML = 2; Severity = 'Medium'; Fix = 'auditpol /set /subcategory:"Audit Policy Change" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-13'; Group = 'Audit policy'; Title = 'Audit Authentication Policy Change';     Key = 'Audit:Authentication Policy Change';     Op = 'contains'; Expected = 'Success';          Ism = 'ISM-0582';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Authentication Policy Change" /success:enable' }
        @{ Id = 'SEC-AUD-14'; Group = 'Audit policy'; Title = 'Audit Sensitive Privilege Use';          Key = 'Audit:Sensitive Privilege Use';          Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1509';          ML = 2; Severity = 'Medium'; Fix = 'auditpol /set /subcategory:"Sensitive Privilege Use" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-15'; Group = 'Audit policy'; Title = 'Audit Security State Change';            Key = 'Audit:Security State Change';            Op = 'contains'; Expected = 'Success';          Ism = 'ISM-0582';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Security State Change" /success:enable' }
        @{ Id = 'SEC-AUD-16'; Group = 'Audit policy'; Title = 'Audit Security System Extension';        Key = 'Audit:Security System Extension';        Op = 'contains'; Expected = 'Success';          Ism = 'ISM-0582';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Security System Extension" /success:enable' }
        @{ Id = 'SEC-AUD-17'; Group = 'Audit policy'; Title = 'Audit System Integrity';                 Key = 'Audit:System Integrity';                 Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-0582';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"System Integrity" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-18'; Group = 'Audit policy'; Title = 'Audit Removable Storage';                Key = 'Audit:Removable Storage';                Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-1418';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Removable Storage" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-19'; Group = 'Audit policy'; Title = 'Audit Other Object Access Events';       Key = 'Audit:Other Object Access Events';       Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-0582';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Other Object Access Events" /success:enable /failure:enable   (scheduled task events)' }
        @{ Id = 'SEC-AUD-20'; Group = 'Audit policy'; Title = 'Audit PNP Activity';                     Key = 'Audit:Plug and Play Events';             Op = 'contains'; Expected = 'Success';          Ism = 'ISM-1418';          ML = 0; Severity = 'Low';    Fix = 'auditpol /set /subcategory:"Plug and Play Events" /success:enable' }
        @{ Id = 'SEC-AUD-21'; Group = 'Audit policy'; Title = 'Audit Kerberos Authentication Service (DC)'; Key = 'Audit:Kerberos Authentication Service'; Op = 'eq'; Expected = 'Success and Failure'; Ism = 'ISM-0582';      ML = 0; Severity = 'Medium'; Applies = 'dc'; Fix = 'auditpol /set /subcategory:"Kerberos Authentication Service" /success:enable /failure:enable' }
        @{ Id = 'SEC-AUD-22'; Group = 'Audit policy'; Title = 'Audit Directory Service Changes (DC)';   Key = 'Audit:Directory Service Changes';        Op = 'contains'; Expected = 'Success';          Ism = 'ISM-1650';          ML = 2; Severity = 'Medium'; Applies = 'dc'; Fix = 'auditpol /set /subcategory:"Directory Service Changes" /success:enable' }

        # ---- Local security policy: account policies (secedit [System Access]) ----
        @{ Id = 'SEC-POL-01'; Group = 'Account policy'; Title = 'Lockout after at most 5 failed attempts';  Key = 'Sec:LockoutBadCount';       Op = 'between'; Expected = '1-5';  Ism = 'ISM-1403'; ML = 0; Severity = 'High';   Fix = 'GPO: Account Policies > Account Lockout Policy > Account lockout threshold = 5 (domain policy governs domain accounts; this is the local policy)' }
        @{ Id = 'SEC-POL-02'; Group = 'Account policy'; Title = 'Minimum password length (single-factor: 15; 17 at SECRET, 20 at TOP SECRET)'; Key = 'Sec:MinimumPasswordLength'; Op = 'ge';     Expected = '15'; ExpectedAt = @{ S = '17'; TS = '20' }; Ism = 'ISM-0421 ISM-1557 ISM-0422'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Account Policies > Password Policy > Minimum password length = 15 (ISM-0421); local accounts follow the local policy' }
        @{ Id = 'SEC-POL-03'; Group = 'Account policy'; Title = 'Password complexity (report)';           Key = 'Sec:PasswordComplexity';    Op = 'report';  Expected = '';     Ism = 'ISM-2080'; ML = 0; Severity = 'Low';    Fix = 'ISM-2080: complexity rules are not imposed when length is 15+; the Microsoft baseline enables them - decide and record in tailoring' }
        @{ Id = 'SEC-POL-04'; Group = 'Account policy'; Title = 'Lockout duration (report)';              Key = 'Sec:LockoutDuration';       Op = 'report';  Expected = '';     Ism = 'ISM-1403'; ML = 0; Severity = 'Low';    Fix = 'ISM-1403: 15 minutes or until an administrator unlocks' }
        @{ Id = 'SEC-POL-05'; Group = 'Account policy'; Title = 'Guest account disabled';                Key = 'Sec:EnableGuestAccount';    Op = 'eq';      Expected = '0';    Ism = 'ISM-0383'; ML = 0; Severity = 'High';   Fix = 'GPO: Local Policies > Security Options > Accounts: Guest account status = Disabled' }
        @{ Id = 'SEC-POL-06'; Group = 'Account policy'; Title = 'Maximum password age (report)';          Key = 'Sec:MaximumPasswordAge';    Op = 'report';  Expected = '';     Ism = 'ISM-0421'; ML = 0; Severity = 'Low';    Fix = 'the ISM no longer requires periodic changes for long passwords; record the decision' }

        # ---- Security options (registry) ----
        @{ Id = 'SEC-OPT-01'; Group = 'Security options'; Title = 'LAN Manager authentication level = NTLMv2 only, refuse LM and NTLM'; Key = 'LSA.LmCompatibilityLevel'; Op = 'eq'; Expected = '5'; Ism = 'ISM-1055'; ML = 0; Severity = 'High'; Fix = 'GPO: Security Options > Network security: LAN Manager authentication level = Send NTLMv2 response only. Refuse LM & NTLM   (HKLM\SYSTEM\CurrentControlSet\Control\Lsa\LmCompatibilityLevel = 5)' }
        @{ Id = 'SEC-OPT-02'; Group = 'Security options'; Title = 'Do not store LAN Manager hashes';       Key = 'LSA.NoLMHash';              Op = 'eq'; Expected = '1'; Ism = 'ISM-1055'; ML = 0; Severity = 'High';   Fix = 'GPO: Security Options > Network security: Do not store LAN Manager hash value on next password change = Enabled' }
        @{ Id = 'SEC-OPT-03'; Group = 'Security options'; Title = 'NTLM SSP minimum client security = NTLMv2 + 128-bit'; Key = 'LSA.NTLMMinClientSec'; Op = 'eq'; Expected = '537395200'; Ism = 'ISM-1055'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > Network security: Minimum session security for NTLM SSP based clients = Require NTLMv2 session security, Require 128-bit encryption' }
        @{ Id = 'SEC-OPT-04'; Group = 'Security options'; Title = 'NTLM SSP minimum server security = NTLMv2 + 128-bit'; Key = 'LSA.NTLMMinServerSec'; Op = 'eq'; Expected = '537395200'; Ism = 'ISM-1055'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > Network security: Minimum session security for NTLM SSP based servers = Require NTLMv2 session security, Require 128-bit encryption' }
        @{ Id = 'SEC-OPT-05'; Group = 'Security options'; Title = 'Restrict anonymous access';             Key = 'LSA.RestrictAnonymous';     Op = 'eq'; Expected = '1'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > Network access: Do not allow anonymous enumeration of SAM accounts and shares = Enabled' }
        @{ Id = 'SEC-OPT-06'; Group = 'Security options'; Title = 'Restrict anonymous SAM enumeration';   Key = 'LSA.RestrictAnonymousSAM';  Op = 'eq'; Expected = '1'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > Network access: Do not allow anonymous enumeration of SAM accounts = Enabled' }
        @{ Id = 'SEC-OPT-07'; Group = 'Security options'; Title = 'Everyone does not include Anonymous';  Key = 'LSA.EveryoneIncludesAnonymous'; Op = 'eq'; Expected = '0'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; NotConfiguredOk = $true; Fix = 'GPO: Security Options > Network access: Let Everyone permissions apply to anonymous users = Disabled' }
        @{ Id = 'SEC-OPT-08'; Group = 'Security options'; Title = 'Blank passwords limited to console logon'; Key = 'LSA.LimitBlankPasswordUse'; Op = 'eq'; Expected = '1'; Ism = 'ISM-1409'; ML = 0; Severity = 'Low'; NotConfiguredOk = $true; Fix = 'GPO: Security Options > Accounts: Limit local account use of blank passwords to console logon only = Enabled' }
        @{ Id = 'SEC-OPT-09'; Group = 'Security options'; Title = 'LSA protection (RunAsPPL)';            Key = 'LSA.RunAsPPL';              Op = 'in'; Expected = '1;2'; Ism = 'ISM-1861'; ML = 3; Severity = 'High';  Fix = 'GPO: System > Local Security Authority > Configure LSASS to run as a protected process = Enabled   (RunAsPPL = 1; needs a reboot)' }
        @{ Id = 'SEC-OPT-10'; Group = 'Security options'; Title = 'Cached logons limited to 1';            Key = 'Logon.CachedLogonsCount';   Op = 'le'; Expected = '1'; Ism = 'ISM-1749'; ML = 0; Severity = 'Medium'; Applies = 'member'; Fix = 'GPO: Security Options > Interactive logon: Number of previous logons to cache = 1' }
        @{ Id = 'SEC-OPT-11'; Group = 'Security options'; Title = 'Machine inactivity limit at most 15 minutes'; Key = 'Logon.InactivityTimeoutSecs'; Op = 'between'; Expected = '1-900'; Ism = 'ISM-2012'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > Interactive logon: Machine inactivity limit = 900 seconds' }
        @{ Id = 'SEC-OPT-12'; Group = 'Security options'; Title = 'Do not display last signed-in user';   Key = 'Logon.DontDisplayLastUserName'; Op = 'eq'; Expected = '1'; Ism = 'ISM-1409'; ML = 0; Severity = 'Low'; Fix = 'GPO: Security Options > Interactive logon: Do not display last user name = Enabled' }
        @{ Id = 'SEC-OPT-13'; Group = 'Security options'; Title = 'SMB server signing required';          Key = 'SMB.ServerSigningRequired'; Op = 'eq'; Expected = 'True'; Ism = 'ISM-1962'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > Microsoft network server: Digitally sign communications (always) = Enabled' }
        @{ Id = 'SEC-OPT-14'; Group = 'Security options'; Title = 'SMB client signing required';          Key = 'SMB.ClientSigningRequired'; Op = 'eq'; Expected = '1';    Ism = 'ISM-1962'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > Microsoft network client: Digitally sign communications (always) = Enabled' }
        @{ Id = 'SEC-OPT-15'; Group = 'Security options'; Title = 'User Account Control enabled';          Key = 'UAC.EnableLUA';             Op = 'eq'; Expected = '1'; Ism = 'ISM-1584'; ML = 0; Severity = 'High'; Fix = 'GPO: Security Options > User Account Control: Run all administrators in Admin Approval Mode = Enabled' }
        @{ Id = 'SEC-OPT-16'; Group = 'Security options'; Title = 'UAC prompts administrators on the secure desktop'; Key = 'UAC.ConsentPromptBehaviorAdmin'; Op = 'in'; Expected = '1;2'; Ism = 'ISM-1584'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Security Options > User Account Control: Behavior of the elevation prompt for administrators = Prompt for consent (or credentials) on the secure desktop' }
        @{ Id = 'SEC-OPT-17'; Group = 'Security options'; Title = 'UAC applies to the built-in Administrator'; Key = 'UAC.FilterAdministratorToken'; Op = 'eq'; Expected = '1'; Ism = 'ISM-1584'; ML = 0; Severity = 'Low'; Fix = 'GPO: Security Options > User Account Control: Admin Approval Mode for the Built-in Administrator account = Enabled' }
        @{ Id = 'SEC-OPT-18'; Group = 'Security options'; Title = 'Autorun disabled for all drives';      Key = 'AutoRun.NoDriveTypeAutoRun'; Op = 'eq'; Expected = '255'; Ism = 'ISM-0341'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Admin Templates > Windows Components > AutoPlay Policies > Turn off AutoPlay = Enabled, All drives' }
        @{ Id = 'SEC-OPT-19'; Group = 'Security options'; Title = 'Autorun commands never executed';      Key = 'AutoRun.NoAutorun';          Op = 'eq'; Expected = '1';   Ism = 'ISM-0341'; ML = 0; Severity = 'Low';    Fix = 'GPO: AutoPlay Policies > Set the default behavior for AutoRun = Do not execute any autorun commands' }

        # ---- User rights (secedit [Privilege Rights]; SIDs) ----
        @{ Id = 'SEC-RGT-01'; Group = 'User rights'; Title = 'Debug programs: Administrators only';           Key = 'Right:SeDebugPrivilege';                 Op = 'subset'; Expected = '*S-1-5-32-544'; Ism = 'ISM-1508'; ML = 3; Severity = 'High';   Fix = 'GPO: User Rights Assignment > Debug programs = Administrators' }
        @{ Id = 'SEC-RGT-02'; Group = 'User rights'; Title = 'Act as part of the operating system: nobody';   Key = 'Right:SeTcbPrivilege';                   Op = 'eq';     Expected = '';              Ism = 'ISM-1508'; ML = 3; Severity = 'High';   NotConfiguredOk = $true; Fix = 'GPO: User Rights Assignment > Act as part of the operating system = (empty)' }
        @{ Id = 'SEC-RGT-03'; Group = 'User rights'; Title = 'Deny log on through Remote Desktop Services includes Guests'; Key = 'Right:SeDenyRemoteInteractiveLogonRight'; Op = 'contains'; Expected = '*S-1-5-32-546'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'GPO: User Rights Assignment > Deny log on through Remote Desktop Services = Guests, NT AUTHORITY\Local account (ASD guidance)' }
        @{ Id = 'SEC-RGT-04'; Group = 'User rights'; Title = 'Deny access from the network includes Guests';   Key = 'Right:SeDenyNetworkLogonRight';          Op = 'contains'; Expected = '*S-1-5-32-546'; Ism = 'ISM-1409'; ML = 0; Severity = 'Medium'; Fix = 'GPO: User Rights Assignment > Deny access to this computer from the network = Guests, NT AUTHORITY\Local account' }
        @{ Id = 'SEC-RGT-05'; Group = 'User rights'; Title = 'Allow log on through RDS: Administrators and Remote Desktop Users only'; Key = 'Right:SeRemoteInteractiveLogonRight'; Op = 'subset'; Expected = '*S-1-5-32-544;*S-1-5-32-555'; Ism = 'ISM-1508'; ML = 3; Severity = 'Medium'; Fix = 'GPO: User Rights Assignment > Allow log on through Remote Desktop Services = Administrators, Remote Desktop Users' }
        @{ Id = 'SEC-RGT-06'; Group = 'User rights'; Title = 'Access this computer from the network (report)'; Key = 'Right:SeNetworkLogonRight';            Op = 'report'; Expected = '';              Ism = 'ISM-1508'; ML = 3; Severity = 'Low';    Fix = 'ASD: Administrators, Authenticated Users (domain controllers add Enterprise Domain Controllers); remove Everyone' }
        @{ Id = 'SEC-RGT-07'; Group = 'User rights'; Title = 'Take ownership: Administrators only';           Key = 'Right:SeTakeOwnershipPrivilege';         Op = 'subset'; Expected = '*S-1-5-32-544'; Ism = 'ISM-1508'; ML = 3; Severity = 'Medium'; Fix = 'GPO: User Rights Assignment > Take ownership of files or other objects = Administrators' }
        @{ Id = 'SEC-RGT-08'; Group = 'User rights'; Title = 'Load and unload device drivers: Administrators only'; Key = 'Right:SeLoadDriverPrivilege';     Op = 'subset'; Expected = '*S-1-5-32-544'; Ism = 'ISM-2128'; ML = 0; Severity = 'Medium'; Fix = 'GPO: User Rights Assignment > Load and unload device drivers = Administrators' }
        @{ Id = 'SEC-RGT-09'; Group = 'User rights'; Title = 'Impersonate a client after authentication (report)'; Key = 'Right:SeImpersonatePrivilege';   Op = 'report'; Expected = '';              Ism = 'ISM-1508'; ML = 3; Severity = 'Low';    Fix = 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE (and IIS_IUSRS on web servers)' }

        # ---- Operating system hardening ----
        @{ Id = 'SEC-OS-01';  Group = 'Operating system'; Title = 'PowerShell 2.0 engine removed';        Key = 'Feature:PowerShell-V2';   Op = 'ne'; Expected = 'Enabled'; Ism = 'ISM-1621'; ML = 3; Severity = 'High';   Fix = 'Disable-WindowsOptionalFeature -Online -FeatureName MicrosoftWindowsPowerShellV2Root   (or Uninstall-WindowsFeature PowerShell-V2)' }
        @{ Id = 'SEC-OS-02';  Group = 'Operating system'; Title = 'SMB version 1 disabled';               Key = 'SMB.SMB1';                Op = 'eq'; Expected = 'False';   Ism = 'ISM-1962'; ML = 0; Severity = 'High';   Fix = 'Set-SmbServerConfiguration -EnableSMB1Protocol $false ; Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol' }
        @{ Id = 'SEC-OS-03';  Group = 'Operating system'; Title = 'SMB1 feature removed';                 Key = 'Feature:FS-SMB1';         Op = 'ne'; Expected = 'Enabled'; Ism = 'ISM-1962'; ML = 0; Severity = 'Medium'; Fix = 'Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -Remove' }
        @{ Id = 'SEC-OS-04';  Group = 'Operating system'; Title = '.NET Framework 3.5 removed';           Key = 'Feature:NET-Framework-3.5'; Op = 'ne'; Expected = 'Enabled'; Ism = 'ISM-1655'; ML = 3; Severity = 'Medium'; Fix = 'Disable-WindowsOptionalFeature -Online -FeatureName NetFx3 -Remove   (check nothing on the server needs .NET 2.0/3.5 first)' }
        @{ Id = 'SEC-OS-05';  Group = 'Operating system'; Title = 'Telnet client removed';                Key = 'Feature:Telnet-Client';   Op = 'ne'; Expected = 'Enabled'; Ism = 'ISM-0380'; ML = 0; Severity = 'Low';    Fix = 'Disable-WindowsOptionalFeature -Online -FeatureName TelnetClient' }
        @{ Id = 'SEC-OS-06';  Group = 'Operating system'; Title = '64-bit operating system';              Key = 'OS.Architecture';         Op = 'contains'; Expected = '64'; Ism = 'ISM-1408'; ML = 0; Severity = 'Low'; Fix = 'rebuild on a 64-bit image' }

        # ---- Platform protection ----
        @{ Id = 'SEC-PLT-01'; Group = 'Platform protection'; Title = 'Exploit protection: DEP on system-wide'; Key = 'ExploitProtection.DEP';  Op = 'eq'; Expected = 'ON';   Ism = 'ISM-1492'; ML = 0; Severity = 'Medium'; Fix = 'Set-ProcessMitigation -System -Enable DEP   (GPO: Windows Defender Exploit Guard > Exploit Protection)' }
        @{ Id = 'SEC-PLT-02'; Group = 'Platform protection'; Title = 'Attack surface reduction rules in block mode'; Key = 'Defender.ASRBlock'; Op = 'ge'; Expected = '1'; Ism = 'ISM-1601'; ML = 0; Severity = 'Medium'; Fix = 'GPO: Microsoft Defender Antivirus > Microsoft Defender Exploit Guard > Attack Surface Reduction > Configure ASR rules (ASD lists the recommended set); Get-MpPreference shows them' }
        @{ Id = 'SEC-PLT-03'; Group = 'Platform protection'; Title = 'Secure Boot enabled';               Key = 'SecureBoot';              Op = 'eq'; Expected = 'True'; Ism = 'ISM-1745'; ML = 0; Severity = 'Medium'; Fix = 'UEFI firmware: enable Secure Boot (VMware: EFI firmware + Secure Boot on the VM)' }
        @{ Id = 'SEC-PLT-04'; Group = 'Platform protection'; Title = 'Memory integrity (HVCI) enabled';   Key = 'DeviceGuard.HVCI';        Op = 'eq'; Expected = 'True'; Ism = 'ISM-1896'; ML = 3; Severity = 'Medium'; Fix = 'GPO: System > Device Guard > Turn On Virtualization Based Security > Virtualization Based Protection of Code Integrity = Enabled (needs VBS; VMware: expose hardware virtualisation to the VM)' }
        @{ Id = 'SEC-PLT-05'; Group = 'Platform protection'; Title = 'Credential Guard running';          Key = 'DeviceGuard.CredentialGuard'; Op = 'eq'; Expected = 'True'; Ism = 'ISM-1686'; ML = 3; Severity = 'Medium'; Applies = 'member'; Fix = 'GPO: System > Device Guard > Turn On Virtualization Based Security > Credential Guard Configuration = Enabled with UEFI lock' }

        # ---- PowerShell, command line, WMI logging ----
        @{ Id = 'SEC-PS-01';  Group = 'PowerShell'; Title = 'PowerShell script block logging on';         Key = 'PS.ScriptBlockLogging';   Op = 'eq'; Expected = '1'; Ism = 'ISM-1623'; ML = 2; Severity = 'High';   Fix = 'GPO: Admin Templates > Windows Components > Windows PowerShell > Turn on PowerShell Script Block Logging = Enabled' }
        @{ Id = 'SEC-PS-02';  Group = 'PowerShell'; Title = 'PowerShell module logging on';               Key = 'PS.ModuleLogging';        Op = 'eq'; Expected = '1'; Ism = 'ISM-1623'; ML = 2; Severity = 'Medium'; Fix = 'GPO: Windows PowerShell > Turn on Module Logging = Enabled, Module Names = *' }
        @{ Id = 'SEC-PS-03';  Group = 'PowerShell'; Title = 'PowerShell transcription on';                Key = 'PS.Transcription';        Op = 'eq'; Expected = '1'; Ism = 'ISM-1623'; ML = 2; Severity = 'Medium'; Fix = 'GPO: Windows PowerShell > Turn on PowerShell Transcription = Enabled, with a protected output directory' }
        @{ Id = 'SEC-PS-04';  Group = 'PowerShell'; Title = 'Protected event logging on';                 Key = 'PS.ProtectedEventLogging'; Op = 'eq'; Expected = '1'; Ism = 'ISM-1624'; ML = 0; Severity = 'Low';   Fix = 'GPO: Admin Templates > Windows Components > Event Logging > Enable Protected Event Logging = Enabled with the encryption certificate' }
        @{ Id = 'SEC-PS-05';  Group = 'PowerShell'; Title = 'PowerShell runs in Constrained Language Mode for users'; Key = 'PS.LanguageMode'; Op = 'eq'; Expected = 'ConstrainedLanguage'; Ism = 'ISM-1622'; ML = 3; Severity = 'Medium'; Fix = 'Enforced through WDAC or AppLocker script rules; the value shown is the mode this tool got in its own session' }
