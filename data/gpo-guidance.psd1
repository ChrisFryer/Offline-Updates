@{
    # =================================================================
    #  gpo-guidance.psd1  -  how to close each Security gap with Group Policy
    # -----------------------------------------------------------------
    #  The Security console's "GPO recommendations" page reads this file.
    #  Gpos:      the GPOs recommended - one per area, linked to the OU of
    #             the member servers (the GPO approach; see the GPO plan).
    #  Settings:  one entry per Security check (Check = its id):
    #    Gpo      which of the GPOs above the setting belongs in
    #    Path     where it is in the Group Policy Management Editor
    #    Value    what to set it to
    #    Default  what Windows does when nothing sets it (shown as "not set - ...")
    #    Rsop     how to recognise it in a server's Resultant Set of Policy,
    #             to tell "missing from Group Policy" from "a GPO sets a
    #             weaker value":
    #               R:<key>\<value>  administrative template (registry.pol)
    #               V:<path>         security option (MACHINE\...)
    #               S:<name>         account policy / account setting
    #               U:<right>        user right
    #               D:<subcategory>  advanced audit policy
    #             (none = not a Group Policy setting, or not visible in RSoP)
    #    Impact   what could break when it is applied
    #    Expect   None / Low / Review - the outcome when no impact check
    #             answers: None and Low = No impact expected (blue),
    #             Review = Check first (amber)
    #    Probes   the impact checks run on each server (lib\45-Security-Gpo.ps1):
    #             their answer decides the outcome - red = impact found (in
    #             use), amber = check first, blue = no impact found.  Green is
    #             only ever "Enforced": a GPO already sets the value
    #  Paths follow the Group Policy Management Editor in Server 2019 / 2022.
    #  Values follow ASD's Windows hardening guidance and the Microsoft
    #  security baseline, like data\security-settings.psd1.
    # =================================================================
    AsOf = '2026-10-22'

    Gpos = @(
        @{ Name = 'Server Baseline - Audit Policy'; Note = 'Advanced Audit Policy Configuration only. Also set Security Options > "Audit: Force audit policy subcategory settings to override audit policy category settings" = Enabled, so the old category settings cannot undo it.' }
        @{ Name = 'Server Baseline - Account Policy (local accounts)'; Note = 'Password and lockout policy in a GPO linked to the servers OU applies to the servers'' LOCAL accounts only. Domain accounts take theirs from the Default Domain Policy (or fine-grained password policies).' }
        @{ Name = 'Server Baseline - Security Options'; Note = 'Local Policies > Security Options and User Rights Assignment.' }
        @{ Name = 'Server Baseline - Network Protocols'; Note = 'SMB, NTLM, LLMNR, TLS and NetBIOS. TLS has no administrative template: use Group Policy Preferences > Registry items.' }
        @{ Name = 'Server Baseline - Remote Access'; Note = 'Remote Desktop and WinRM. Keep WinRM on HTTP 5985 with Kerberos working - this tool needs it.' }
        @{ Name = 'Server Baseline - Logging'; Note = 'PowerShell logging, process command lines, event log sizes, event forwarding.' }
        @{ Name = 'Server Baseline - Platform Protection'; Note = 'LSA protection, virtualization based security, Defender attack surface reduction and exploit protection, removable storage, AutoPlay, Internet Explorer.' }
        @{ Name = 'Server Baseline - Firewall'; Note = 'Windows Defender Firewall with Advanced Security: profiles on, inbound blocked by default, an allow rule for every service the servers offer (WinRM 5985 for this tool).' }
        @{ Name = 'Server Baseline - Credentials (LAPS)'; Note = 'Windows LAPS: back the local Administrator password up to Active Directory. Needs the schema update and the OU permissions first (Update-LapsADSchema, Set-LapsADComputerSelfPermission).' }
        @{ Name = 'Server Baseline - Application Control'; Note = 'AppLocker (or a WDAC policy): audit first, read events 8003 / 8006 for a few weeks, then enforce.' }
        @{ Name = 'Not Group Policy (build or change script)'; Note = 'Windows features and firmware cannot be set by an administrative template: remove the feature in the server build (SOE), or with a change-managed script; Secure Boot is a firmware (VM) setting.' }
    )

    Settings = @(
        # ---- Audit policy ----
        @{ Check = 'SEC-AUD-01'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Account Logon > Audit Credential Validation'; Value = 'Success and Failure'; Rsop = @('D:Credential Validation'); Impact = 'More events in the Security log; nothing on the server changes.'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-02'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Logon/Logoff > Audit Logon'; Value = 'Success and Failure'; Rsop = @('D:Logon'); Impact = 'More events in the Security log.'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-03'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Logon/Logoff > Audit Logoff'; Value = 'Success'; Rsop = @('D:Logoff'); Impact = 'More events in the Security log.'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-04'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Logon/Logoff > Audit Account Lockout'; Value = 'Failure'; Rsop = @('D:Account Lockout'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-05'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Logon/Logoff > Audit Special Logon'; Value = 'Success'; Rsop = @('D:Special Logon'); Impact = 'More events in the Security log (every administrator logon).'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-06'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Logon/Logoff > Audit Other Logon/Logoff Events'; Value = 'Success and Failure'; Rsop = @('D:Other Logon/Logoff Events'); Impact = 'More events in the Security log.'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-07'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Account Management > Audit User Account Management'; Value = 'Success and Failure'; Rsop = @('D:User Account Management'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-08'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Account Management > Audit Security Group Management'; Value = 'Success and Failure'; Rsop = @('D:Security Group Management'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-09'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Account Management > Audit Computer Account Management'; Value = 'Success and Failure'; Rsop = @('D:Computer Account Management'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-10'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Account Management > Audit Other Account Management Events'; Value = 'Success and Failure'; Rsop = @('D:Other Account Management Events'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-11'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Detailed Tracking > Audit Process Creation'; Value = 'Success'; Rsop = @('D:Process Creation'); Impact = 'One event per process start: a busy server logs many - the Security log must be large enough or forwarded.'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-12'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Policy Change > Audit Audit Policy Change'; Value = 'Success and Failure'; Rsop = @('D:Audit Policy Change'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-13'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Policy Change > Audit Authentication Policy Change'; Value = 'Success'; Rsop = @('D:Authentication Policy Change'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-14'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Privilege Use > Audit Sensitive Privilege Use'; Value = 'Success and Failure'; Rsop = @('D:Sensitive Privilege Use'); Impact = 'Can add many events on servers where services use privileges often (backup agents).'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-15'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > System > Audit Security State Change'; Value = 'Success'; Rsop = @('D:Security State Change'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-16'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > System > Audit Security System Extension'; Value = 'Success'; Rsop = @('D:Security System Extension'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-17'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > System > Audit System Integrity'; Value = 'Success and Failure'; Rsop = @('D:System Integrity'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-18'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Object Access > Audit Removable Storage'; Value = 'Success and Failure'; Rsop = @('D:Removable Storage'); Impact = 'Events for every file opened on removable media.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-AUD-19'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Object Access > Audit Other Object Access Events'; Value = 'Success and Failure'; Rsop = @('D:Other Object Access Events'); Impact = 'More events (scheduled task changes and others).'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-20'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Detailed Tracking > Audit PNP Activity'; Value = 'Success'; Rsop = @('D:Plug and Play Events'); Impact = 'A few more events in the Security log.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-AUD-21'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > Account Logon > Audit Kerberos Authentication Service (domain controllers: the DC baseline GPO)'; Value = 'Success and Failure'; Rsop = @('D:Kerberos Authentication Service'); Impact = 'Many events on a domain controller: size the Security log for it.'; Expect = 'Low'; Probes = @('SecurityLogSize') }
        @{ Check = 'SEC-AUD-22'; Gpo = 'Server Baseline - Audit Policy'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Advanced Audit Policy Configuration > Audit Policies > DS Access > Audit Directory Service Changes (domain controllers: the DC baseline GPO)'; Value = 'Success'; Rsop = @('D:Directory Service Changes'); Impact = 'Events for directory changes that the object''s audit settings (SACL) cover.'; Expect = 'Low'; Probes = @('SecurityLogSize') }

        # ---- Account policy (local accounts) ----
        @{ Check = 'SEC-POL-01'; Gpo = 'Server Baseline - Account Policy (local accounts)'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Account Policies > Account Lockout Policy > Account lockout threshold'; Value = '5 invalid logon attempts'; Rsop = @('S:LockoutBadCount'); Impact = 'A local account that keeps failing to log on - a service or task with an old password, a scanner - locks out.'; Expect = 'Review'; Probes = @('LockoutRisk') }
        @{ Check = 'SEC-POL-02'; Gpo = 'Server Baseline - Account Policy (local accounts)'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Account Policies > Password Policy > Minimum password length'; Value = '15 characters (17 on a SECRET network, 20 on TOP SECRET - ISM-1557 / ISM-0422)'; Rsop = @('S:MinimumPasswordLength'); Impact = 'Applies at the next password change of a local account; existing passwords keep working.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-POL-05'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Accounts: Guest account status'; Value = 'Disabled'; Rsop = @('S:EnableGuestAccount'); Impact = 'Anything that logs on as Guest (anonymous shares on very old set-ups) stops.'; Expect = 'Low'; Probes = @('GuestLogons') }

        # ---- Security options ----
        @{ Check = 'SEC-OPT-01'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Network security: LAN Manager authentication level'; Value = 'Send NTLMv2 response only. Refuse LM & NTLM'; Default = 'Windows default: 3 - sends NTLMv2 responses, still accepts LM and NTLM'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\LmCompatibilityLevel'); Impact = 'Clients and applications that log on to this server with LM or NTLMv1 are refused: old appliances, scanners, non-Windows clients, very old Windows.'; Expect = 'Review'; Probes = @('NtlmV1Logons') }
        @{ Check = 'SEC-OPT-02'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Network security: Do not store LAN Manager hash value on next password change'; Value = 'Enabled'; Default = 'Windows default: 1 - not stored'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\NoLMHash'); Impact = 'None for current logons; LM hashes are not stored from the next password change.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-OPT-03'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Network security: Minimum session security for NTLM SSP based (including secure RPC) clients'; Value = 'Require NTLMv2 session security, Require 128-bit encryption'; Default = 'Windows default: 536870912 - 128-bit encryption, NTLMv2 session security not required'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0\NTLMMinClientSec'); Impact = 'NTLM connections FROM this server to systems without NTLMv2 128-bit session security fail (every Windows since Vista has it).'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-OPT-04'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Network security: Minimum session security for NTLM SSP based (including secure RPC) servers'; Value = 'Require NTLMv2 session security, Require 128-bit encryption'; Default = 'Windows default: 536870912 - 128-bit encryption, NTLMv2 session security not required'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0\NTLMMinServerSec'); Impact = 'Clients that cannot do NTLMv2 session security with 128-bit encryption are refused.'; Expect = 'Review'; Probes = @('NtlmV1Logons') }
        @{ Check = 'SEC-OPT-05'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Network access: Do not allow anonymous enumeration of SAM accounts and shares'; Value = 'Enabled'; Default = 'Windows default: 0 - anonymous listing of shares allowed'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\RestrictAnonymous'); Impact = 'Anonymous (null session) listing of shares and accounts stops - very old clients, some NAS and "scan to folder" set-ups use it.'; Expect = 'Review'; Probes = @('AnonymousLogons') }
        @{ Check = 'SEC-OPT-06'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Network access: Do not allow anonymous enumeration of SAM accounts'; Value = 'Enabled'; Default = 'Windows default: 1 - not allowed'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\RestrictAnonymousSAM'); Impact = 'Anonymous listing of local accounts stops.'; Expect = 'Low'; Probes = @('AnonymousLogons') }
        @{ Check = 'SEC-OPT-07'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Network access: Let Everyone permissions apply to anonymous users'; Value = 'Disabled'; Default = 'Windows default: 0 - disabled'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\EveryoneIncludesAnonymous'); Impact = 'Anonymous users lose what is granted to Everyone.'; Expect = 'Low'; Probes = @('AnonymousLogons') }
        @{ Check = 'SEC-OPT-08'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Accounts: Limit local account use of blank passwords to console logon only'; Value = 'Enabled'; Default = 'Windows default: 1 - enabled'; Rsop = @('V:MACHINE\System\CurrentControlSet\Control\Lsa\LimitBlankPasswordUse'); Impact = 'A local account with a blank password can no longer log on over the network.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-OPT-09'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > System > Local Security Authority > Configure LSASS to run as a protected process (Server 2022 templates; older: Group Policy Preferences > Registry, HKLM\SYSTEM\CurrentControlSet\Control\Lsa RunAsPPL = 1)'; Value = 'Enabled with UEFI Lock'; Default = 'Windows default: off on Server 2016 - 2022'; Rsop = @('R:System\CurrentControlSet\Control\Lsa\RunAsPPL'); Impact = 'LSA refuses plug-ins that are not signed for a protected process: third-party password filters, authentication or smart-card packages stop loading. Needs a reboot.'; Expect = 'Review'; Probes = @('LsaPlugins') }
        @{ Check = 'SEC-OPT-10'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Interactive logon: Number of previous logons to cache (in case domain controller is not available)'; Value = '1'; Default = 'Windows default: 10 logons cached'; Rsop = @('V:MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon\CachedLogonsCount'); Impact = 'When no domain controller answers, only the last account to log on can log on with cached credentials.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-OPT-11'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Interactive logon: Machine inactivity limit'; Value = '900 seconds'; Default = 'Windows default: no limit'; Rsop = @('V:MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\InactivityTimeoutSecs'); Impact = 'Idle console and RDP sessions lock after 15 minutes; programs keep running.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-OPT-12'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Interactive logon: Do not display last user name'; Value = 'Enabled'; Default = 'Windows default: 0 - the last user name is shown'; Rsop = @('V:MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\DontDisplayLastUserName'); Impact = 'The logon screen no longer shows the last user name.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-OPT-13'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Microsoft network server: Digitally sign communications (always)'; Value = 'Enabled'; Default = 'Windows default: not required on member servers (required on domain controllers)'; Rsop = @('V:MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters\RequireSecuritySignature'); Impact = 'SMB clients that cannot sign (old NAS, scanners, some Linux / Samba clients, Windows XP) can no longer reach the shares; signing costs some throughput on busy file servers.'; Expect = 'Review'; Probes = @('SmbClients') }
        @{ Check = 'SEC-OPT-14'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > Microsoft network client: Digitally sign communications (always)'; Value = 'Enabled'; Default = 'Windows default: 0 - not required'; Rsop = @('V:MACHINE\System\CurrentControlSet\Services\LanmanWorkstation\Parameters\RequireSecuritySignature'); Impact = 'Connections FROM this server to SMB servers that cannot sign (old NAS) fail.'; Expect = 'Review'; Probes = @('SmbOutbound') }
        @{ Check = 'SEC-OPT-15'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > User Account Control: Run all administrators in Admin Approval Mode'; Value = 'Enabled'; Default = 'Windows default: 1 - on'; Rsop = @('V:MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\EnableLUA'); Impact = 'Needs a reboot; programs that assumed full administrator rights without elevating prompt or fail.'; Expect = 'Review'; Probes = @() }
        @{ Check = 'SEC-OPT-16'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > User Account Control: Behavior of the elevation prompt for administrators in Admin Approval Mode'; Value = 'Prompt for consent on the secure desktop'; Default = 'Windows default: 5 - consent for programs that are not part of Windows'; Rsop = @('V:MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\ConsentPromptBehaviorAdmin'); Impact = 'Administrators see the elevation prompt on the secure desktop.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-OPT-17'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > Security Options > User Account Control: Admin Approval Mode for the Built-in Administrator account'; Value = 'Enabled'; Default = 'Windows default: 0 - the built-in Administrator is not filtered'; Rsop = @('V:MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\FilterAdministratorToken'); Impact = 'The built-in Administrator gets UAC prompts, and tools that use it over the network get a filtered token.'; Expect = 'Review'; Probes = @('BuiltinAdminLogons') }
        @{ Check = 'SEC-OPT-18'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > AutoPlay Policies > Turn off Autoplay'; Value = 'Enabled: All drives'; Default = 'Windows default: 145 - AutoPlay off for network and unknown drives only'; Rsop = @('R:Software\Microsoft\Windows\CurrentVersion\Policies\Explorer\NoDriveTypeAutoRun'); Impact = 'Media no longer plays automatically.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-OPT-19'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > AutoPlay Policies > Set the default behavior for AutoRun'; Value = 'Enabled: Do not execute any autorun commands'; Default = 'Windows default: autorun commands are run'; Rsop = @('R:Software\Microsoft\Windows\CurrentVersion\Policies\Explorer\NoAutorun'); Impact = 'Autorun files on media are ignored.'; Expect = 'None'; Probes = @() }

        # ---- User rights ----
        @{ Check = 'SEC-RGT-01'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > User Rights Assignment > Debug programs'; Value = 'Administrators'; Rsop = @('U:SeDebugPrivilege'); Impact = 'Accounts other than Administrators lose the right to debug processes (some monitoring, backup or database agents ask for it).'; Expect = 'Review'; Probes = @('RightHolders') }
        @{ Check = 'SEC-RGT-02'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > User Rights Assignment > Act as part of the operating system'; Value = '(no one: define the policy with no account)'; Rsop = @('U:SeTcbPrivilege'); Impact = 'Accounts that hold it lose it; a service that needs it stops working.'; Expect = 'Review'; Probes = @('RightHolders') }
        @{ Check = 'SEC-RGT-03'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > User Rights Assignment > Deny log on through Remote Desktop Services'; Value = 'Guests (ASD also adds NT AUTHORITY\Local account - check that no local account is used over RDP first)'; Rsop = @('U:SeDenyRemoteInteractiveLogonRight'); Impact = 'Guests cannot log on over RDP; with Local account added, no local account can.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-RGT-04'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > User Rights Assignment > Deny access to this computer from the network'; Value = 'Guests (ASD also adds NT AUTHORITY\Local account)'; Rsop = @('U:SeDenyNetworkLogonRight'); Impact = 'Guests cannot connect over the network; with Local account added, local accounts cannot either (tools that use a local account remotely stop).'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-RGT-05'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > User Rights Assignment > Allow log on through Remote Desktop Services'; Value = 'Administrators, Remote Desktop Users'; Rsop = @('U:SeRemoteInteractiveLogonRight'); Impact = 'Accounts or groups granted RDP directly lose it - put them in Remote Desktop Users instead.'; Expect = 'Review'; Probes = @('RightHolders') }
        @{ Check = 'SEC-RGT-07'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > User Rights Assignment > Take ownership of files or other objects'; Value = 'Administrators'; Rsop = @('U:SeTakeOwnershipPrivilege'); Impact = 'Other accounts that hold it lose it.'; Expect = 'Review'; Probes = @('RightHolders') }
        @{ Check = 'SEC-RGT-08'; Gpo = 'Server Baseline - Security Options'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Local Policies > User Rights Assignment > Load and unload device drivers'; Value = 'Administrators'; Rsop = @('U:SeLoadDriverPrivilege'); Impact = 'Other accounts that hold it lose it (print operators on old print servers).'; Expect = 'Review'; Probes = @('RightHolders') }

        # ---- Operating system: features (not Group Policy) and SMB1 ----
        @{ Check = 'SEC-OS-01'; Gpo = 'Not Group Policy (build or change script)'; Path = 'Not a Group Policy setting: remove the feature in the build, or with a change-managed script (Disable-WindowsOptionalFeature -Online -FeatureName MicrosoftWindowsPowerShellV2Root)'; Value = 'Removed'; Rsop = @(); Impact = 'Scripts or products that start PowerShell with -Version 2 fail.'; Expect = 'Review'; Probes = @('PsV2Use') }
        @{ Check = 'SEC-OS-02'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Administrative Templates > MS Security Guide > Configure SMB v1 server (the MS Security Guide template from Microsoft''s Security Compliance Toolkit; without it: Group Policy Preferences > Registry, HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters SMB1 = 0)'; Value = 'Disabled'; Rsop = @('R:SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters\SMB1'); Impact = 'Clients that only speak SMB1 - Windows XP / Server 2003, old NAS, scanners, some printers and embedded devices - can no longer reach this server''s shares.'; Expect = 'Review'; Probes = @('Smb1Sessions', 'Smb1Audit') }
        @{ Check = 'SEC-OS-03'; Gpo = 'Not Group Policy (build or change script)'; Path = 'Not a Group Policy setting: Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -Remove, in the build or a change-managed script'; Value = 'Removed'; Rsop = @(); Impact = 'As SMB1 disabled, and this server can no longer connect to SMB1-only servers either.'; Expect = 'Review'; Probes = @('Smb1Sessions', 'Smb1Audit', 'Smb1Outbound') }
        @{ Check = 'SEC-OS-04'; Gpo = 'Not Group Policy (build or change script)'; Path = 'Not a Group Policy setting: Disable-WindowsOptionalFeature -Online -FeatureName NetFx3 -Remove'; Value = 'Removed'; Rsop = @(); Impact = 'Programs built for .NET Framework 2.0 - 3.5 stop starting.'; Expect = 'Review'; Probes = @('NetFx2Use') }
        @{ Check = 'SEC-OS-05'; Gpo = 'Not Group Policy (build or change script)'; Path = 'Not a Group Policy setting: Disable-WindowsOptionalFeature -Online -FeatureName TelnetClient'; Value = 'Removed'; Rsop = @(); Impact = 'telnet.exe goes - scripts that use it to test a port fail (Test-NetConnection does the same).'; Expect = 'Low'; Probes = @() }

        # ---- Platform protection ----
        @{ Check = 'SEC-PLT-01'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Windows Defender Exploit Guard > Exploit Protection > Use a common set of exploit protection settings'; Value = 'Enabled: an exported settings XML with DEP on (Get-ProcessMitigation -RegistryConfigFilePath)'; Default = 'Windows default: OptIn - DEP for Windows programs and those that opt in'; Rsop = @('R:Software\Policies\Microsoft\Windows Defender ExploitGuard\Exploit Protection\ExploitProtectionSettings'); Impact = 'Old programs that run code from data pages crash.'; Expect = 'Review'; Probes = @() }
        @{ Check = 'SEC-PLT-02'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Microsoft Defender Antivirus > Microsoft Defender Exploit Guard > Attack Surface Reduction > Configure Attack Surface Reduction rules'; Value = 'Enabled: ASD''s rule set - audit (2) for a few weeks, then block (1)'; Default = 'Windows default: no rule'; Rsop = @('R:Software\Policies\Microsoft\Windows Defender\Windows Defender Exploit Guard\ASR\ExploitGuard_ASR_Rules'); Impact = 'Legitimate tools that behave like malware - Office macros, script launchers, programs reading LSASS - are blocked.'; Expect = 'Review'; Probes = @('AsrAudit') }
        @{ Check = 'SEC-PLT-03'; Gpo = 'Not Group Policy (build or change script)'; Path = 'Not a Group Policy setting: firmware - a VM needs EFI firmware with Secure Boot ticked'; Value = 'On'; Rsop = @(); Impact = 'A BIOS-booted VM cannot just be switched: its disk must be GPT, so it means a rebuild or a conversion (mbr2gpt) in a change window.'; Expect = 'Review'; Probes = @() }
        @{ Check = 'SEC-PLT-04'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > System > Device Guard > Turn On Virtualization Based Security > Virtualization Based Protection of Code Integrity'; Value = 'Enabled with UEFI lock'; Rsop = @('R:SOFTWARE\Policies\Microsoft\Windows\DeviceGuard\HypervisorEnforcedCodeIntegrity'); Impact = 'Drivers that are not HVCI-compatible no longer load (old storage, backup or antivirus filter drivers); needs hardware virtualisation exposed to the VM and a reboot.'; Expect = 'Review'; Probes = @('VbsCapable') }
        @{ Check = 'SEC-PLT-05'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > System > Device Guard > Turn On Virtualization Based Security > Credential Guard Configuration'; Value = 'Enabled with UEFI lock'; Rsop = @('R:SOFTWARE\Policies\Microsoft\Windows\DeviceGuard\LsaCfgFlags'); Impact = 'NTLMv1, MS-CHAPv2, Digest and CredSSP with saved credentials stop working, and Kerberos unconstrained delegation and DES with them.'; Expect = 'Review'; Probes = @('VbsCapable', 'NtlmV1Logons') }

        # ---- PowerShell and logging ----
        @{ Check = 'SEC-PS-01'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Windows PowerShell > Turn on PowerShell Script Block Logging'; Value = 'Enabled'; Default = 'Windows default: off (only script blocks Windows thinks suspicious are logged)'; Rsop = @('R:Software\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging\EnableScriptBlockLogging'); Impact = 'More events in the PowerShell log; script text - and any secret in it - is logged.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-PS-02'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Windows PowerShell > Turn on Module Logging'; Value = 'Enabled, Module Names = *'; Default = 'Windows default: off'; Rsop = @('R:Software\Policies\Microsoft\Windows\PowerShell\ModuleLogging\EnableModuleLogging'); Impact = 'Many more PowerShell events (every pipeline).'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-PS-03'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Windows PowerShell > Turn on PowerShell Transcription'; Value = 'Enabled, with an output directory users cannot read'; Default = 'Windows default: off'; Rsop = @('R:Software\Policies\Microsoft\Windows\PowerShell\Transcription\EnableTranscripting'); Impact = 'Every PowerShell session writes a transcript file: it needs a protected folder and disk space.'; Expect = 'Review'; Probes = @('DiskForLogs') }
        @{ Check = 'SEC-PS-04'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Event Logging > Enable Protected Event Logging'; Value = 'Enabled, with the document-encryption certificate'; Default = 'Windows default: off'; Rsop = @('R:Software\Policies\Microsoft\Windows\EventLog\ProtectedEventLogging\EnableProtectedEventLogging'); Impact = 'Needs an encryption certificate on every server; whoever reads the events (the SIEM) needs its private key.'; Expect = 'Review'; Probes = @() }
        @{ Check = 'SEC-PS-05'; Gpo = 'Server Baseline - Application Control'; Path = 'Not a single setting: Constrained Language Mode follows from an application control policy (WDAC, or AppLocker script rules) - see the Application Control GPO'; Value = 'Script rules enforced'; Rsop = @('R:Software\Policies\Microsoft\Windows\SrpV2\Script\EnforcementMode'); Impact = 'Scripts the policy does not allow run in Constrained Language Mode: management tools and agents that call .NET directly break.'; Expect = 'Review'; Probes = @('AppLockerAudit') }
        @{ Check = 'SEC-PS-06'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > System > Audit Process Creation > Include command line in process creation events'; Value = 'Enabled'; Default = 'Windows default: off'; Rsop = @('R:Software\Microsoft\Windows\CurrentVersion\Policies\System\Audit\ProcessCreationIncludeCmdLine_Enabled'); Impact = 'Command lines - including any password typed on one - appear in event 4688.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-PS-07'; Gpo = 'Server Baseline - Logging'; Path = 'No administrative template: Group Policy Preferences > Registry, HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\WINEVT\Channels\Microsoft-Windows-WMI-Activity/Operational Enabled = 1'; Value = 'Enabled'; Rsop = @(); Impact = 'A few more events.'; Expect = 'None'; Probes = @() }
        @{ Check = 'SEC-MED-01'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > System > Removable Storage Access > All Removable Storage classes: Deny all access'; Value = 'Enabled'; Default = 'Windows default: removable storage allowed'; Rsop = @('R:Software\Policies\Microsoft\Windows\RemovableStorageDevices\Deny_All'); Impact = 'USB drives, CD / DVD and other removable storage stop working on the server - an ISO mounted to a VM''s CD drive included.'; Expect = 'Review'; Probes = @('UsbStorage') }
        @{ Check = 'SEC-LOG-02'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Event Log Service > Security > Specify the maximum log file size (KB)'; Value = '196608 or more'; Rsop = @('R:Software\Policies\Microsoft\Windows\EventLog\Security\MaxSize'); Impact = 'The log file can grow to that size on the system drive.'; Expect = 'Low'; Probes = @('DiskForLogs') }
        @{ Check = 'SEC-LOG-03'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Event Log Service > System > Specify the maximum log file size (KB)'; Value = '32768 or more'; Rsop = @('R:Software\Policies\Microsoft\Windows\EventLog\System\MaxSize'); Impact = 'The log file can grow to that size on the system drive.'; Expect = 'Low'; Probes = @('DiskForLogs') }
        @{ Check = 'SEC-LOG-04'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Event Log Service > Application > Specify the maximum log file size (KB)'; Value = '32768 or more'; Rsop = @('R:Software\Policies\Microsoft\Windows\EventLog\Application\MaxSize'); Impact = 'The log file can grow to that size on the system drive.'; Expect = 'Low'; Probes = @('DiskForLogs') }
        @{ Check = 'SEC-LOG-01'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Event Forwarding > Configure target Subscription Manager'; Value = 'Server=http://<collector FQDN>:5985/wsman/SubscriptionManager/WEC,Refresh=60'; Rsop = @('R:Software\Policies\Microsoft\Windows\EventLog\EventForwarding\SubscriptionManager\1'); Impact = 'Needs a Windows Event Collector; NETWORK SERVICE must be able to read the Security log (Event Log Readers, or the log''s channel access).'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-LOG-05'; Gpo = 'Server Baseline - Logging'; Path = 'Computer Configuration > Policies > Administrative Templates > System > Windows Time Service > Time Providers > Configure Windows NTP Client (only for a server that is NOT a domain member or is the PDC emulator; members follow the domain)'; Value = 'Type = NT5DS for members'; Rsop = @('R:Software\Policies\Microsoft\W32time\Parameters\Type'); Impact = 'The server takes its time from the domain hierarchy.'; Expect = 'Low'; Probes = @() }

        # ---- Remote access ----
        @{ Check = 'SEC-NET-01'; Gpo = 'Server Baseline - Remote Access'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Remote Desktop Services > Remote Desktop Session Host > Security > Require user authentication for remote connections by using Network Level Authentication'; Value = 'Enabled'; Rsop = @('R:SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services\UserAuthentication'); Impact = 'RDP clients that cannot do NLA (very old clients, some thin clients and gateways) cannot connect, and a user whose password must change cannot change it at the RDP logon screen.'; Expect = 'Review'; Probes = @('RdpLogons') }
        @{ Check = 'SEC-NET-02'; Gpo = 'Server Baseline - Remote Access'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Remote Desktop Services > Remote Desktop Session Host > Security > Require use of specific security layer for remote (RDP) connections'; Value = 'SSL'; Rsop = @('R:SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services\SecurityLayer'); Impact = 'Clients that cannot do TLS cannot connect (none in current use).'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-NET-03'; Gpo = 'Server Baseline - Remote Access'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Windows Remote Management (WinRM) > WinRM Service > Allow Basic authentication'; Value = 'Disabled'; Rsop = @('R:Software\Policies\Microsoft\Windows\WinRM\Service\AllowBasic'); Impact = 'Tools that connect with Basic authentication - some Linux, Ansible or monitoring set-ups - are refused.'; Expect = 'Review'; Probes = @('CleartextLogons') }
        @{ Check = 'SEC-NET-04'; Gpo = 'Server Baseline - Remote Access'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Windows Remote Management (WinRM) > WinRM Service > Allow unencrypted traffic'; Value = 'Disabled'; Rsop = @('R:Software\Policies\Microsoft\Windows\WinRM\Service\AllowUnencryptedTraffic'); Impact = 'Clients that send unencrypted WinRM traffic (Basic over HTTP) are refused. Kerberos over HTTP 5985 is encrypted - this tool keeps working.'; Expect = 'Review'; Probes = @('CleartextLogons') }
        @{ Check = 'SEC-NET-05'; Gpo = 'Server Baseline - Remote Access'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Windows Remote Management (WinRM) > WinRM Client > Trusted Hosts'; Value = 'Disabled (and the local list cleared)'; Default = 'Windows default: empty'; Rsop = @('R:Software\Policies\Microsoft\Windows\WinRM\Client\TrustedHosts'); Impact = 'Remoting FROM this server to hosts by IP address or outside the domain (NTLM) stops.'; Expect = 'Review'; Probes = @('TrustedHostsList') }
        @{ Check = 'SEC-NET-06'; Gpo = 'Server Baseline - Network Protocols'; Path = 'No administrative template: Group Policy Preferences > Windows Settings > Registry, HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.0\Server - Enabled = 0 and DisabledByDefault = 1 (DWORD)'; Value = 'Disabled'; Default = 'Windows default: on (Server 2019 and 2022 still accept TLS 1.0)'; Rsop = @(); Impact = 'Clients and applications that can only use TLS 1.0 - older .NET programs, Java 6 / 7, old SQL clients and appliances - cannot connect to TLS services on this server. Needs a reboot.'; Expect = 'Review'; Probes = @('TlsListeners') }
        @{ Check = 'SEC-NET-07'; Gpo = 'Server Baseline - Network Protocols'; Path = 'No administrative template: Group Policy Preferences > Windows Settings > Registry, ...\SCHANNEL\Protocols\TLS 1.1\Server - Enabled = 0 and DisabledByDefault = 1'; Value = 'Disabled'; Default = 'Windows default: on (Server 2019 and 2022 still accept TLS 1.1)'; Rsop = @(); Impact = 'Clients limited to TLS 1.1 cannot connect to TLS services on this server. Needs a reboot.'; Expect = 'Review'; Probes = @('TlsListeners') }
        # ---- SECRET / TOP SECRET only (grey on a PROTECTED network): cryptography and radios ----
        @{ Check = 'SEC-CRY-01'; Gpo = 'Server Baseline - Network Protocols'; Path = 'No administrative template: Group Policy Preferences > Windows Settings > Registry, HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\KeyExchangeAlgorithms\Diffie-Hellman - ServerMinKeyBitLength (DWORD)'; Value = '3072'; Default = 'Windows default: 2048 bits'; Rsop = @(); Impact = 'A TLS client that only offers 2048-bit Diffie-Hellman groups can no longer connect with a DHE suite (most clients use ECDHE and are unaffected).'; Expect = 'Review'; Probes = @('TlsListeners') }
        @{ Check = 'SEC-CRY-02'; Gpo = 'Server Baseline - Credentials (LAPS)'; Path = 'Not a Group Policy setting: the key size comes from the certificate template on the issuing CA (Cryptography tab > Minimum key size) and from the request'; Value = 'RSA 3072 or 4096 bits'; Rsop = @(); Impact = 'A re-issued certificate must be rebound to the service that uses it (IIS, RDP, WinRM HTTPS, LDAPS).'; Expect = 'Review'; Probes = @() }
        @{ Check = 'SEC-CRY-03'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Administrative Templates > Network > SSL Configuration Settings > SSL Cipher Suite Order'; Value = 'TLS_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384'; Default = 'Windows default: the full suite list, AES-128 and SHA-1 suites included'; Rsop = @('R:SOFTWARE\Policies\Microsoft\Cryptography\Configuration\SSL\00010002\Functions'); Impact = 'Every TLS client of the server must support an AES-256 GCM SHA-384 suite; older clients and appliances may not.'; Expect = 'Review'; Probes = @('TlsListeners') }
        @{ Check = 'SEC-CRY-04'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Administrative Templates > Network > SSL Configuration Settings > SSL Cipher Suite Order'; Value = 'the GCM and CBC SHA-256 / SHA-384 suites only - no *_SHA, *_NULL_*, RC4 or 3DES suite'; Default = 'Windows default: SHA-1, NULL and 3DES suites are still offered'; Rsop = @('R:SOFTWARE\Policies\Microsoft\Cryptography\Configuration\SSL\00010002\Functions'); Impact = 'A client that only speaks a SHA-1 or 3DES suite (Windows Server 2008 R2 era, old appliances) can no longer connect.'; Expect = 'Review'; Probes = @('TlsListeners') }
        @{ Check = 'SEC-CRY-05'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Administrative Templates > Network > SSL Configuration Settings > ECC Curve Order'; Value = 'NistP384, NistP521 (and NistP256 on a SECRET network)'; Default = 'Windows default: curve25519, NistP256, NistP384'; Rsop = @('R:SOFTWARE\Policies\Microsoft\Cryptography\Configuration\SSL\00010002\EccCurves'); Impact = 'A client that only offers curve25519 (some Linux builds) falls back to another key exchange or fails to connect.'; Expect = 'Review'; Probes = @('TlsListeners') }
        @{ Check = 'SEC-WLS-01'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > System Services > WLAN AutoConfig = Disabled; the radio itself: firmware or Device Manager'; Value = 'no Wi-Fi or Bluetooth radio present; WLAN AutoConfig disabled'; Rsop = @('S:WlanSvc'); Impact = 'None on a wired server; a server that was reached over Wi-Fi loses that path.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-NET-08'; Gpo = 'Server Baseline - Network Protocols'; Path = 'No administrative template: Group Policy Preferences > Windows Settings > Registry, ...\SCHANNEL\Protocols\SSL 3.0\Server - Enabled = 0 and DisabledByDefault = 1'; Value = 'Disabled'; Default = 'Windows default: off on Server 2016 and later'; Rsop = @(); Impact = 'Only clients from before 2014 use SSL 3.0.'; Expect = 'Low'; Probes = @('TlsListeners') }
        @{ Check = 'SEC-NET-09'; Gpo = 'Server Baseline - Network Protocols'; Path = 'Computer Configuration > Policies > Administrative Templates > Network > DNS Client > Turn off multicast name resolution'; Value = 'Enabled'; Default = 'Windows default: on - names resolve by multicast'; Rsop = @('R:Software\Policies\Microsoft\Windows NT\DNSClient\EnableMulticast'); Impact = 'Names that are not in DNS no longer resolve by multicast on the local subnet.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-NET-10'; Gpo = 'Server Baseline - Network Protocols'; Path = 'No administrative template: DHCP option 001 (Microsoft Disable NetBIOS Option = 0x2) for DHCP servers; static servers: a change-managed script (Win32_NetworkAdapterConfiguration SetTcpipNetbios(2))'; Value = 'Disabled on every adapter'; Rsop = @(); Impact = 'Clients that reach the server by NetBIOS name without DNS, WINS, or SMB over port 139 (very old clients) stop working; network browse lists go.'; Expect = 'Review'; Probes = @('NetbtSessions') }

        # ---- Code checks with a Group Policy answer ----
        @{ Check = 'SEC-FW-01'; Gpo = 'Server Baseline - Firewall'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Windows Defender Firewall with Advanced Security > Properties: Domain, Private and Public profile - Firewall state On, Inbound connections Block (default)'; Value = 'On, inbound blocked, allow rules for the services offered'; Rsop = @('R:SOFTWARE\Policies\Microsoft\WindowsFirewall\DomainProfile\EnableFirewall'); Impact = 'Inbound connections no allow rule covers are blocked: every service the server offers needs a rule (this tool needs WinRM 5985).'; Expect = 'Review'; Probes = @('Listeners') }
        @{ Check = 'SEC-CRD-01'; Gpo = 'Server Baseline - Credentials (LAPS)'; Path = 'Computer Configuration > Policies > Administrative Templates > System > LAPS > Configure password backup directory'; Value = 'Active Directory'; Rsop = @('R:Software\Microsoft\Windows\CurrentVersion\Policies\LAPS\BackupDirectory', 'R:Software\Policies\Microsoft Services\AdmPwd\AdmPwdEnabled'); Impact = 'The local Administrator password changes and is kept in Active Directory: anyone using the old shared password must read the new one there.'; Expect = 'Review'; Probes = @('BuiltinAdminLogons') }
        @{ Check = 'SEC-OS-09'; Gpo = 'Server Baseline - Platform Protection'; Path = 'Computer Configuration > Policies > Administrative Templates > Windows Components > Internet Explorer > Disable Internet Explorer 11 as a standalone browser'; Value = 'Enabled'; Rsop = @('R:Software\Policies\Microsoft\Internet Explorer\Main\DisableInternetExplorerApp'); Impact = 'Internet Explorer 11 opens Edge instead; old intranet pages need Edge''s IE mode.'; Expect = 'Low'; Probes = @() }
        @{ Check = 'SEC-AC-01'; Gpo = 'Server Baseline - Application Control'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Application Control Policies > AppLocker (audit only first, then enforce) - or a WDAC policy'; Value = 'Executable, installer and script rules enforced'; Rsop = @('R:Software\Policies\Microsoft\Windows\SrpV2\Exe\EnforcementMode'); Impact = 'Anything the rules do not allow is blocked - installers, admin tools, agents and scripts included.'; Expect = 'Review'; Probes = @('AppLockerAudit') }
        @{ Check = 'SEC-AC-02'; Gpo = 'Server Baseline - Application Control'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Application Control Policies > AppLocker (audit only first, then enforce) - or a WDAC policy'; Value = 'Executable, installer and script rules enforced'; Rsop = @('R:Software\Policies\Microsoft\Windows\SrpV2\Exe\EnforcementMode'); Impact = 'Anything the rules do not allow is blocked - installers, admin tools, agents and scripts included.'; Expect = 'Review'; Probes = @('AppLockerAudit') }
        @{ Check = 'SEC-AC-03'; Gpo = 'Server Baseline - Application Control'; Path = 'Computer Configuration > Policies > Windows Settings > Security Settings > Application Control Policies > AppLocker > Script Rules and Windows Installer Rules'; Value = 'Rules enforced'; Rsop = @('R:Software\Policies\Microsoft\Windows\SrpV2\Script\EnforcementMode', 'R:Software\Policies\Microsoft\Windows\SrpV2\Msi\EnforcementMode'); Impact = 'Scripts and installers the rules do not allow are blocked.'; Expect = 'Review'; Probes = @('AppLockerAudit') }
    )
}
